// Two windows, one tile each, so the test renders them separately.
// `about_tile.slint` is generated by build.rs from templates/about_tile.json.
import { Dir } from "theme.slint";
import { HandAboutTile } from "hand.slint";
import { AboutTile } from "about_tile.slint";

export { Dir }

export component HandWindow inherits Window {
    in property <length> u: 2px;
    in property <string> version;
    in property <string> status;
    width: 250 * u;
    height: 141 * u;
    background: #000;
    HandAboutTile { u: root.u; version: root.version; status: root.status; }
}

export component GenWindow inherits Window {
    in property <length> u: 2px;
    in property <string> version;
    in property <string> status;
    width: 250 * u;
    height: 141 * u;
    background: #000;
    AboutTile { u: root.u; version: root.version; status: root.status; }
}
