<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Launcher updates only (Updater, SECURITY.md § Launcher updates): once a day the
         latest release's JSON from api.github.com; the APK and SHA256SUMS from GitHub
         only when the user picks Install in About. Nothing else uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hands a verified update of this app to Android's installer. Android still asks
         the user to allow "Install unknown apps" for RustTV once, and to confirm each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the launcher apply the three allowlisted animation scales after the
         on-TV confirmation (HISTORY.md § 7). Granted only from the Mac
         (`rusttv history allow-tv-settings`), never by the app itself; one
         Kotlin writer (SecureSettings) is the only code that uses it. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Hides other apps' overlays while the review screen is open (HISTORY.md § 6.2). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Package visibility (API 30+): see launchable TV apps without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="RustTV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:hasCode="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="false">

        <!-- Lets `adb` profile the app (Perfetto heapprofd, CPU sampling). Only in
             builds made with -Prusttv.profileable=true for measurements: the shell
             could otherwise read the app's memory, so such builds can't approve
             changes on the TV (History.testBuild, HISTORY.md § 6.2). -->
        <profileable android:shell="${profileable}" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="rusttv_launcher" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Offers RustTV as Home. On Google TV the stock launcher still wins
                 until the opt-in Home takeover (SECURITY.md); nothing here changes it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The outcome of an update install (Updater.commit). Not exported: only this
             app's own PendingIntent, sent by the system installer, reaches it. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />

        <!-- The pointer in other apps (REMOTE.md § 5): gestures and an overlay only
             (res/xml/pointer_service.xml). Off until the person turns it on in
             Android's accessibility settings; only the system can bind it. -->
        <service
            android:name=".PointerService"
            android:label="@string/pointer_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pointer_service" />
        </service>

        <!-- The history door (HISTORY.md § 5). Exported without a permission
             because the adb shell holds none of ours; every entry point checks
             that the caller is the shell (HistoryProvider.checkShell). -->
        <provider
            android:name=".HistoryProvider"
            android:authorities="ai.rusttv.launcher.history"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
