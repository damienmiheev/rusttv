<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Launcher updates only (Updater, SECURITY.md § Launcher updates): once a day the
         latest release's JSON from api.github.com; the APK and SHA256SUMS from GitHub
         only when the user picks Install in About. Nothing else uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hands a verified update of this app to Android's installer. Android still asks
         the user to allow "Install unknown apps" for RustTV once, and to confirm each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Package visibility (API 30+): see launchable TV apps without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="RustTV"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="false">

        <!-- Lets `adb` profile the app (Perfetto heapprofd, CPU sampling) on a
             release build. No effect on behaviour or speed. -->
        <profileable android:shell="true" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="rusttv_launcher" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Offers RustTV as Home. On Google TV the stock launcher still wins
                 until the opt-in Home takeover (SECURITY.md); nothing here changes it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The outcome of an update install (Updater.commit). Not exported: only this
             app's own PendingIntent, sent by the system installer, reaches it. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
