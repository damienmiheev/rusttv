#!/bin/sh
# Stand-in for `adb` in the CLI tests, selected with RUSTTV_ADB.
# FAKE_ADB_SCENARIO picks the behaviour; output mimics adb 1.0.41.
# A committed script (not written at test time) avoids "text file busy"
# races when tests run in parallel.

# Device commands arrive as `-s <serial> shell ...`; match on what follows.
if [ "$1" = "-s" ]; then
    shift 2
fi
captures="$(dirname "$0")/../../../rusttv-core/src/fixtures/emulator-pixel3a-api34"

case "$FAKE_ADB_SCENARIO:$*" in
emulator:devices\ -l)
    cat "$captures/devices-l.txt"
    ;;
emulator:shell\ getprop)
    cat "$captures/getprop.txt"
    ;;
emulator:shell\ cat\ /proc/meminfo)
    cat "$captures/meminfo.txt"
    ;;
emulator:shell\ df\ -k\ /data)
    cat "$captures/df-data.txt"
    ;;
emulator:shell\ pm\ list\ packages\ -f)
    cat "$captures/packages-f.txt"
    ;;
emulator:shell\ pm\ list\ packages\ -3)
    cat "$captures/packages-3.txt"
    ;;
emulator:shell\ pm\ list\ packages\ -d)
    cat "$captures/packages-d.txt"
    ;;
two-devices:devices*)
    printf 'List of devices attached\n'
    printf 'emulator-5554          device product:sdk_google_atv_x86 model:Android_TV_on_x86 device:generic_x86 transport_id:1\n'
    printf '192.168.1.20:5555      unauthorized transport_id:2\n\n'
    ;;
no-devices:devices*)
    printf 'List of devices attached\n\n'
    ;;
connect-ok:connect*)
    echo "connected to $2"
    ;;
connect-ok:devices*)
    printf 'List of devices attached\n192.168.1.20:5555      unauthorized transport_id:3\n\n'
    ;;
connect-refused:connect*)
    # Real adb exits 0 on connection failures.
    echo "failed to connect to '$2': Connection refused"
    ;;
*)
    echo "fake-adb: unexpected call: $*" >&2
    exit 1
    ;;
esac
