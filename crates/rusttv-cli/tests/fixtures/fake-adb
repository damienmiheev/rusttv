#!/bin/sh
# Stand-in for `adb` in the CLI tests, selected with RUSTTV_ADB.
# FAKE_ADB_SCENARIO picks the behaviour; output mimics adb 1.0.41.
# A committed script (not written at test time) avoids "text file busy"
# races when tests run in parallel.

# Device commands arrive as `-s <serial> shell ...`; match on what follows.
if [ "$1" = "-s" ]; then
    shift 2
fi
captures="$(dirname "$0")/../../../rusttv-core/src/fixtures/emulator-pixel3a-api34"
tv_captures="$(dirname "$0")/../../../rusttv-core/src/fixtures/google-tv-emulator-api34"
synthetic="$(dirname "$0")/../../../rusttv-core/src/fixtures/synthetic-home-takeover"
install="$(dirname "$0")/../../../rusttv-core/src/fixtures/synthetic-launcher-install"
pm_errors="$(dirname "$0")/../../../rusttv-core/src/fixtures/synthetic-pm-list-errors"

case "$FAKE_ADB_SCENARIO:$*" in
tv:devices\ -l)
    cat "$captures/devices-l.txt"
    ;;
tv:shell\ cmd\ package\ resolve-activity\ *)
    cat "$tv_captures/home-activity.txt"
    ;;
tv:shell\ cmd\ package\ query-activities\ *)
    cat "$tv_captures/home-candidates.txt"
    ;;
tv:shell\ getprop)
    cat "$synthetic/getprop.txt"
    ;;
tv:shell\ pm\ list\ packages\ -3)
    cat "$synthetic/packages-3.txt"
    ;;
tv:shell\ pm\ list\ packages\ -f)
    cat "$install/packages-f-rusttv.txt"
    ;;
# The same TV before the RustTV launcher is installed.
tv-fresh:devices\ -l)
    cat "$captures/devices-l.txt"
    ;;
tv-fresh:shell\ getprop)
    cat "$synthetic/getprop.txt"
    ;;
tv-fresh:shell\ pm\ list\ packages\ -f)
    cat "$install/packages-f-no-rusttv.txt"
    ;;
emulator:devices\ -l)
    cat "$captures/devices-l.txt"
    ;;
emulator:shell\ getprop)
    cat "$captures/getprop.txt"
    ;;
emulator:shell\ cat\ /proc/meminfo)
    cat "$captures/meminfo.txt"
    ;;
emulator:shell\ df\ -k\ /data)
    cat "$captures/df-data.txt"
    ;;
emulator:shell\ pm\ list\ packages\ -f)
    cat "$captures/packages-f.txt"
    ;;
emulator:shell\ pm\ list\ packages\ -3)
    cat "$captures/packages-3.txt"
    ;;
emulator:shell\ pm\ list\ packages\ -d)
    cat "$captures/packages-d.txt"
    ;;
emulator:shell\ am\ force-stop\ *)
    ;;
emulator:shell\ am\ start\ -W\ -n\ ai.rusttv.spike/.LauncherActivity)
    cat "$tv_captures/am-start-cold.txt"
    ;;
emulator:shell\ am\ start\ -W\ -n\ ai.rusttv.spike/.Missing)
    # Real `am` exits 0 on this error too.
    cat "$tv_captures/am-start-error.txt"
    ;;
emulator:shell\ dumpsys\ meminfo\ ai.rusttv.spike)
    cat "$captures/meminfo-launcher.txt"
    ;;
emulator:shell\ ps\ -A\ -o\ PID,TIME+,NAME)
    cat "$tv_captures/ps-time.txt"
    ;;
emulator:shell\ cat\ /proc/stat)
    cat "$captures/proc-stat-1.txt"
    ;;
emulator:shell\ ps\ -A\ -o\ PID,RSS,NAME)
    cat "$captures/ps.txt"
    ;;
emulator:shell\ cmd\ package\ resolve-activity\ *)
    cat "$captures/home-activity.txt"
    ;;
emulator:shell\ dumpsys\ meminfo\ com.google.android.apps.nexuslauncher)
    cat "$captures/meminfo-launcher.txt"
    ;;
two-devices:devices*)
    printf 'List of devices attached\n'
    printf 'emulator-5554          device product:sdk_google_atv_x86 model:Android_TV_on_x86 device:generic_x86 transport_id:1\n'
    printf '192.168.1.20:5555      unauthorized transport_id:2\n\n'
    ;;
no-devices:devices*)
    printf 'List of devices attached\n\n'
    ;;
# The emulator, but `pm list packages -d` fails the way it does without
# adb's shell protocol: exit 0, the error on stdout.
pm-fails:devices\ -l)
    cat "$captures/devices-l.txt"
    ;;
pm-fails:shell\ pm\ list\ packages\ -f)
    cat "$captures/packages-f.txt"
    ;;
pm-fails:shell\ pm\ list\ packages\ -3)
    cat "$captures/packages-3.txt"
    ;;
pm-fails:shell\ pm\ list\ packages\ -d)
    cat "$pm_errors/cant-find-service.txt"
    ;;
connect-ok:connect*)
    echo "connected to $2"
    ;;
connect-ok:devices*)
    printf 'List of devices attached\n192.168.1.20:5555      unauthorized transport_id:3\n\n'
    ;;
connect-refused:connect*)
    # Real adb exits 0 on connection failures.
    echo "failed to connect to '$2': Connection refused"
    ;;
*)
    echo "fake-adb: unexpected call: $*" >&2
    exit 1
    ;;
esac
