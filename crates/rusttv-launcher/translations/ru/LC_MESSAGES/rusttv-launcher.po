msgid "Checking for updates…"
msgstr "Проверка обновлений…"

msgid "Up to date"
msgstr "Обновлений нет"

msgid "Version {} available — press OK to install"
msgstr "Доступна версия {} — нажмите OK, чтобы установить"

msgid "Allow RustTV to install apps, then press OK to install {}"
msgstr "Разрешите RustTV устанавливать приложения, затем нажмите OK, чтобы установить {}"

msgid "Downloading {}%"
msgstr "Загрузка {}%"

msgid "Installing…"
msgstr "Установка…"

msgid "Update installed"
msgstr "Обновление установлено"

msgid "Update failed: {}"
msgstr "Не удалось обновить: {}"

msgid "Press OK to check for updates"
msgstr "Нажмите OK, чтобы проверить обновления"

msgid "Hide from Home"
msgstr "Скрыть с главного экрана"

msgid "Move"
msgstr "Переместить"

msgid "Couldn't open {}"
msgstr "Не удалось открыть {}"

msgid "Couldn't load apps: {}"
msgstr "Не удалось загрузить приложения: {}"

msgid "Couldn't load the licence notices: {}"
msgstr "Не удалось загрузить сведения о лицензиях: {}"

msgid "About RustTV"
msgstr "О RustTV"

msgid "Hidden apps"
msgstr "Скрытые приложения"

msgid "About"
msgstr "О программе"

msgid "OK puts the app back on Home. Back returns."
msgstr "OK возвращает приложение на главный экран. «Назад» — вернуться."

msgid "Version {} · MIT OR Apache-2.0"
msgstr "Версия {} · MIT OR Apache-2.0"

msgid "Built with Slint under the Slint Royalty-free License 2.0. Also includes Skia (BSD-3-Clause) and Rust libraries under MIT or Apache-2.0."
msgstr "Создано на Slint по лицензии Slint Royalty-free License 2.0. Также включает Skia (BSD-3-Clause) и библиотеки Rust по лицензии MIT или Apache-2.0."

msgid "Source: github.com/damienmiheev/rusttv"
msgstr "Исходный код: github.com/damienmiheev/rusttv"

msgid "Up and Down scroll the notices. Back returns."
msgstr "Кнопки вверх и вниз прокручивают текст. «Назад» — вернуться."

msgid "Third-party notices"
msgstr "Лицензии сторонних компонентов"
