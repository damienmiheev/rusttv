msgid "Up to date"
msgstr "Aggiornato"

msgid "Version {} available — press OK to install"
msgstr "Versione {} disponibile — premi OK per installarla"

msgid "Allow RustTV to install apps, then press OK to install {}"
msgstr "Consenti a RustTV di installare app, poi premi OK per installare {}"

msgid "Downloading {}%"
msgstr "Download: {}%"

