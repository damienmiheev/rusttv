msgid "Checking for updates…"
msgstr "جارٍ البحث عن تحديثات…"

msgid "Up to date"
msgstr "محدَّث"

msgid "Version {} available — press OK to install"
msgstr "الإصدار {} متاح — اضغط OK للتثبيت"

msgid "Allow RustTV to install apps, then press OK to install {}"
msgstr "اسمح لـ RustTV بتثبيت التطبيقات، ثم اضغط OK لتثبيت {}"

msgid "Downloading {}%"
msgstr "جارٍ التنزيل {}%"

msgid "Installing…"
msgstr "جارٍ التثبيت…"

msgid "Update installed"
msgstr "تم تثبيت التحديث"

msgid "Update failed: {}"
msgstr "تعذّر التحديث: {}"

msgid "Press OK to check for updates"
msgstr "اضغط OK للبحث عن تحديثات"

msgid "Hide from Home"
msgstr "إخفاء من الشاشة الرئيسية"

msgid "Move"
msgstr "نقل"

msgid "Couldn't open {}"
msgstr "تعذّر فتح {}"

msgid "Couldn't load apps: {}"
msgstr "تعذّر تحميل التطبيقات: {}"

msgid "Couldn't load the licence notices: {}"
msgstr "تعذّر تحميل إشعارات الترخيص: {}"

msgid "Hidden apps"
msgstr "التطبيقات المخفية"

msgid "About"
msgstr "حول"

msgid "OK puts the app back on Home. Back returns."
msgstr "اضغط OK لإعادة التطبيق إلى الشاشة الرئيسية، و«رجوع» للعودة."

msgid "Version {} · MIT OR Apache-2.0"
msgstr "الإصدار {} · MIT OR Apache-2.0"

msgid "Built with Slint under the Slint Royalty-free License 2.0. Also includes Skia (BSD-3-Clause) and Rust libraries under MIT or Apache-2.0."
msgstr "تم الإنشاء باستخدام Slint بموجب ترخيص Slint Royalty-free License 2.0. يتضمن أيضًا Skia (BSD-3-Clause) ومكتبات Rust بموجب ترخيص MIT أو Apache-2.0."

msgid "Source: github.com/damienmiheev/rusttv"
msgstr "الرمز المصدر: github.com/damienmiheev/rusttv"

msgid "Up and Down scroll the notices. Back returns."
msgstr "استخدم الأعلى والأسفل للتمرير، و«رجوع» للعودة."

msgid "Third-party notices"
msgstr "إشعارات الجهات الخارجية"

msgid "Updates"
msgstr "التحديثات"

msgid "History"
msgstr "السجل"

msgid "Waiting for your computer"
msgstr "بانتظار الكمبيوتر"

msgid "Animations"
msgstr "الرسوم المتحركة"

msgid "Faster (0.5×)"
msgstr "أسرع (0.5×)"

msgid "Off"
msgstr "إيقاف"

msgid "Normal"
msgstr "عادي"

msgid "On"
msgstr "تشغيل"

msgid "Transition animations"
msgstr "حركة الانتقالات"

msgid "Window animations"
msgstr "حركة النوافذ"

msgid "App animations"
msgstr "حركة التطبيقات"

msgid "off"
msgstr "متوقف"

msgid "not seen"
msgstr "غير موجود"

msgid "on"
msgstr "يعمل"

msgid "default"
msgstr "الافتراضي"

msgid "Your computer"
msgstr "الكمبيوتر"

msgid "Changed outside RustTV"
msgstr "تم التغيير خارج RustTV"

msgid "Restored from your computer"
msgstr "تمت الاستعادة من الكمبيوتر"

msgid "This TV"
msgstr "هذا التلفزيون"

msgid "time unknown"
msgstr "وقت غير معروف"

msgid "Apps reordered"
msgstr "تمت إعادة ترتيب التطبيقات"

msgid "Hid {}"
msgstr "تم إخفاء {}"

msgid "Showed {}"
msgstr "تم إظهار {}"

msgid "Check for updates: {}"
msgstr "البحث عن تحديثات: {}"

msgid "{}: {} → {}"
msgstr "{}: {} ← {}"

msgid "Firmware updated"
msgstr "تم تحديث البرنامج الثابت"

msgid "Home takeover: {}"
msgstr "استبدال الشاشة الرئيسية: {}"

msgid "No change"
msgstr "لا تغيير"

msgid "Your computer applies these: run rusttv history apply-pending within 2 hours"
msgstr "يطبّقها الكمبيوتر: شغّل rusttv history apply-pending خلال ساعتين"

msgid "This TV changes now"
msgstr "يتغيّر على التلفزيون الآن"

msgid "To change this on the TV itself, run rusttv history allow-tv-settings on your computer once. Until then your computer applies it."
msgstr "لتغيير هذا على التلفزيون نفسه، شغّل rusttv history allow-tv-settings على الكمبيوتر مرة واحدة. وحتى ذلك الحين يطبّقه الكمبيوتر."

msgid "Some apps may look odd without animations."
msgstr "قد تبدو بعض التطبيقات غريبة دون رسوم متحركة."

msgid "No changes yet. Changes made here or from your computer appear here."
msgstr "لا تغييرات بعد. ستظهر هنا التغييرات التي تُجرى على التلفزيون أو من الكمبيوتر."

msgid "{} (+{} more)"
msgstr "{} (+{} أخرى)"

msgid "Restore this state"
msgstr "استعادة هذه الحالة"

msgid "Check for updates automatically"
msgstr "البحث عن تحديثات تلقائيًا"

msgid "{} min"
msgstr "{} دقيقة"

msgid "{} h {} min"
msgstr "{} ساعة و{} دقيقة"

msgid "On your computer, run rusttv history apply-pending within {}."
msgstr "على الكمبيوتر، شغّل rusttv history apply-pending خلال {}."

msgid "Applied."
msgstr "تم التطبيق."

msgid "Saved for your computer. {}"
msgstr "تم الحفظ ليطبّقه الكمبيوتر. {}"

msgid "Nothing changed: {}"
msgstr "لم يتغيّر شيء: {}"

msgid "Nothing changed: wrong code."
msgstr "لم يتغيّر شيء: رمز خاطئ."

msgid "Too many wrong codes. Approvals are locked for {}."
msgstr "رموز خاطئة كثيرة. الموافقات مقفلة لمدة {}."

msgid "Approvals are off in test builds."
msgstr "الموافقات متوقفة في الإصدارات التجريبية."

msgid "Busy — try again in a moment."
msgstr "مشغول — حاول مجددًا بعد قليل."

msgid "Couldn't undo everything: {}. Fix it with rusttv history restore on your computer, or in Android Settings."
msgstr "تعذّر التراجع عن كل شيء: {}. أصلحه باستخدام rusttv history restore على الكمبيوتر، أو من إعدادات Android."

msgid "This is the state now: nothing to restore."
msgstr "هذه هي الحالة الحالية: لا شيء لاستعادته."

msgid "Your computer has a newer RustTV. Update RustTV on this TV."
msgstr "لدى الكمبيوتر إصدار أحدث من RustTV. حدّث RustTV على هذا التلفزيون."

msgid "Reading history…"
msgstr "جارٍ قراءة السجل…"

msgid "History couldn't be read: {}. Your computer's copy can put it back."
msgstr "تعذّرت قراءة السجل: {}. يمكن للنسخة الموجودة على الكمبيوتر استعادته."

msgid "Settings"
msgstr "الإعدادات"

msgid "Up and Down choose, OK opens. Back returns."
msgstr "استخدم الأعلى والأسفل للاختيار، وOK للفتح، و«رجوع» للعودة."

msgid "Review changes"
msgstr "مراجعة التغييرات"

msgid "Up and Down read the changes. Choose Approve to go on. Back cancels."
msgstr "استخدم الأعلى والأسفل لقراءة التغييرات. اختر «موافقة» للمتابعة، و«رجوع» للإلغاء."

msgid "Nothing changes until you hold OK. Back cancels."
msgstr "لن يتغيّر شيء حتى تضغط مطولًا على OK. «رجوع» للإلغاء."

msgid "Approve"
msgstr "موافقة"

msgid "Press these arrows on the remote:"
msgstr "اضغط هذه الأسهم على جهاز التحكم:"

msgid "Now hold OK to apply."
msgstr "اضغط الآن مطولًا على OK للتطبيق."

msgid "Fastest (0.25×)"
msgstr "الأسرع (0.25×)"

msgid "Fast (0.75×)"
msgstr "سريع (0.75×)"

msgid "Slower (1.5×)"
msgstr "أبطأ (1.5×)"

msgid "Slowest (2×)"
msgstr "الأبطأ (2×)"

msgid "History started"
msgstr "بدأ السجل"

msgid "Added {}"
msgstr "أُضيف {}"

msgid "Removed {}"
msgstr "أُزيل {}"
