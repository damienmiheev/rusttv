msgstr "Tamaño: {} %"

msgid "Source code"
msgstr "Código fuente"

msgid "The app restarts at the new size"
msgstr "La app se reinicia con el nuevo tamaño"

msgid "Volume"
msgstr "Volumen"

msgid "✓ on the keyboard confirms, Back cancels"
msgstr "✓ en el teclado confirma, Atrás cancela"

