msgid "Checking for updates…"
msgstr "अपडेट देखे जा रहे हैं…"

msgid "Up to date"
msgstr "सबसे नया वर्शन"

msgid "Version {} available — press OK to install"
msgstr "वर्शन {} उपलब्ध है — इंस्टॉल करने के लिए OK दबाएं"

msgid "Allow RustTV to install apps, then press OK to install {}"
msgstr "RustTV को ऐप्लिकेशन इंस्टॉल करने की अनुमति दें, फिर {} इंस्टॉल करने के लिए OK दबाएं"

msgid "Downloading {}%"
msgstr "डाउनलोड हो रहा है {}%"

msgid "Installing…"
msgstr "इंस्टॉल हो रहा है…"

msgid "Update installed"
msgstr "अपडेट इंस्टॉल हो गया"

msgid "Update failed: {}"
msgstr "अपडेट नहीं हो सका: {}"

msgid "Press OK to check for updates"
msgstr "अपडेट देखने के लिए OK दबाएं"

msgid "Hide from Home"
msgstr "होम स्क्रीन से छिपाएं"

msgid "Move"
msgstr "जगह बदलें"

msgid "Couldn't open {}"
msgstr "{} नहीं खुल सका"

msgid "Couldn't load apps: {}"
msgstr "ऐप्लिकेशन लोड नहीं हो सके: {}"

msgid "Couldn't load the licence notices: {}"
msgstr "लाइसेंस नोटिस लोड नहीं हो सके: {}"

msgid "Hidden apps"
msgstr "छिपाए गए ऐप्लिकेशन"

msgid "About"
msgstr "जानकारी"

msgid "OK puts the app back on Home. Back returns."
msgstr "OK दबाकर ऐप्लिकेशन को होम स्क्रीन पर वापस लाएं। लौटने के लिए 'वापस' दबाएं।"

msgid "Version {} · MIT OR Apache-2.0"
msgstr "वर्शन {} · MIT OR Apache-2.0"

msgid "Built with Slint under the Slint Royalty-free License 2.0. Also includes Skia (BSD-3-Clause) and Rust libraries under MIT or Apache-2.0."
msgstr "Slint Royalty-free License 2.0 के तहत Slint से बनाया गया। इसमें Skia (BSD-3-Clause) और MIT या Apache-2.0 के तहत Rust लाइब्रेरी भी शामिल हैं।"

msgid "Source: github.com/damienmiheev/rusttv"
msgstr "सोर्स कोड: github.com/damienmiheev/rusttv"

msgid "Up and Down scroll the notices. Back returns."
msgstr "ऊपर और नीचे से नोटिस स्क्रॉल करें। लौटने के लिए 'वापस' दबाएं।"

msgid "Third-party notices"
msgstr "तीसरे पक्ष के नोटिस"

msgid "Updates"
msgstr "अपडेट"

msgid "History"
msgstr "इतिहास"

msgid "Waiting for your computer"
msgstr "आपके कंप्यूटर का इंतज़ार"

msgid "Animations"
msgstr "ऐनिमेशन"

msgid "Faster (0.5×)"
msgstr "तेज़ (0.5×)"

msgid "Off"
msgstr "बंद"

msgid "Normal"
msgstr "सामान्य"

msgid "On"
msgstr "चालू"

msgid "Transition animations"
msgstr "ट्रांज़िशन ऐनिमेशन"

msgid "Window animations"
msgstr "विंडो ऐनिमेशन"

msgid "App animations"
msgstr "ऐप्लिकेशन ऐनिमेशन"

msgid "off"
msgstr "बंद"

msgid "not seen"
msgstr "नहीं मिला"

msgid "on"
msgstr "चालू"

msgid "default"
msgstr "डिफ़ॉल्ट"

msgid "Your computer"
msgstr "आपका कंप्यूटर"

msgid "Changed outside RustTV"
msgstr "RustTV के बाहर बदला गया"

msgid "Restored from your computer"
msgstr "आपके कंप्यूटर से बहाल किया गया"

msgid "This TV"
msgstr "यह टीवी"

msgid "time unknown"
msgstr "समय अज्ञात"

msgid "Apps reordered"
msgstr "ऐप्लिकेशन का क्रम बदला गया"

msgid "Hid {}"
msgstr "{} छिपाया गया"

msgid "Showed {}"
msgstr "{} दिखाया गया"

msgid "Check for updates: {}"
msgstr "अपडेट की जांच: {}"

msgid "{}: {} → {}"
msgstr "{}: {} → {}"

msgid "Firmware updated"
msgstr "फ़र्मवेयर अपडेट हुआ"

msgid "Home takeover: {}"
msgstr "होम स्क्रीन बदलना: {}"

msgid "No change"
msgstr "कोई बदलाव नहीं"

msgid "Your computer applies these: run rusttv history apply-pending within 2 hours"
msgstr "इन्हें आपका कंप्यूटर लागू करेगा: 2 घंटे के अंदर rusttv history apply-pending चलाएं"

msgid "This TV changes now"
msgstr "यह टीवी अभी बदलेगा"

msgid "To change this on the TV itself, run rusttv history allow-tv-settings on your computer once. Until then your computer applies it."
msgstr "इसे सीधे टीवी पर बदलने के लिए, अपने कंप्यूटर पर एक बार rusttv history allow-tv-settings चलाएं। तब तक इसे आपका कंप्यूटर लागू करेगा।"

msgid "Some apps may look odd without animations."
msgstr "ऐनिमेशन के बिना कुछ ऐप्लिकेशन अजीब दिख सकते हैं।"

msgid "No changes yet. Changes made here or from your computer appear here."
msgstr "अभी कोई बदलाव नहीं। टीवी पर या आपके कंप्यूटर से किए गए बदलाव यहां दिखेंगे।"

msgid "{} (+{} more)"
msgstr "{} (+{} और)"

msgid "Restore this state"
msgstr "यह स्थिति बहाल करें"

msgid "Check for updates automatically"
msgstr "अपडेट की अपने-आप जांच करें"

msgid "{} min"
msgstr "{} मिनट"

msgid "{} h {} min"
msgstr "{} घंटे {} मिनट"

msgid "On your computer, run rusttv history apply-pending within {}."
msgstr "अपने कंप्यूटर पर {} के अंदर rusttv history apply-pending चलाएं।"

msgid "Applied."
msgstr "लागू किया गया।"

msgid "Saved for your computer. {}"
msgstr "आपके कंप्यूटर के लिए सहेजा गया। {}"

msgid "Nothing changed: {}"
msgstr "कुछ नहीं बदला: {}"

msgid "Nothing changed: wrong code."
msgstr "कुछ नहीं बदला: गलत कोड।"

msgid "Too many wrong codes. Approvals are locked for {}."
msgstr "बहुत ज़्यादा गलत कोड। मंज़ूरी {} के लिए लॉक है।"

msgid "Approvals are off in test builds."
msgstr "टेस्ट बिल्ड में मंज़ूरी बंद है।"

msgid "Busy — try again in a moment."
msgstr "व्यस्त है — थोड़ी देर में फिर कोशिश करें।"

msgid "Couldn't undo everything: {}. Fix it with rusttv history restore on your computer, or in Android Settings."
msgstr "सब कुछ पहले जैसा नहीं हो सका: {}। इसे अपने कंप्यूटर पर rusttv history restore से या Android सेटिंग में ठीक करें।"

msgid "This is the state now: nothing to restore."
msgstr "अभी यही स्थिति है: बहाल करने को कुछ नहीं।"

msgid "Your computer has a newer RustTV. Update RustTV on this TV."
msgstr "आपके कंप्यूटर पर RustTV का नया वर्शन है। इस टीवी पर RustTV अपडेट करें।"

msgid "Reading history…"
msgstr "इतिहास पढ़ा जा रहा है…"

msgid "History couldn't be read: {}. Your computer's copy can put it back."
msgstr "इतिहास पढ़ा नहीं जा सका: {}। आपके कंप्यूटर की कॉपी से इसे वापस लाया जा सकता है।"

msgid "Settings"
msgstr "सेटिंग"

msgid "Up and Down choose, OK opens. Back returns."
msgstr "ऊपर और नीचे से चुनें, OK से खोलें। लौटने के लिए 'वापस' दबाएं।"

msgid "Review changes"
msgstr "बदलाव देखें"

msgid "Up and Down read the changes. Choose Approve to go on. Back cancels."
msgstr "ऊपर और नीचे से बदलाव पढ़ें। आगे बढ़ने के लिए 'मंज़ूर करें' चुनें। रद्द करने के लिए 'वापस' दबाएं।"

msgid "Nothing changes until you hold OK. Back cancels."
msgstr "OK दबाकर रखने तक कुछ नहीं बदलेगा। रद्द करने के लिए 'वापस' दबाएं।"

msgid "Approve"
msgstr "मंज़ूर करें"

msgid "Press these arrows on the remote:"
msgstr "रिमोट पर ये तीर दबाएं:"

msgid "Now hold OK to apply."
msgstr "अब लागू करने के लिए OK दबाकर रखें।"

msgid "Fastest (0.25×)"
msgstr "सबसे तेज़ (0.25×)"

msgid "Fast (0.75×)"
msgstr "तेज़ (0.75×)"

msgid "Slower (1.5×)"
msgstr "धीमा (1.5×)"

msgid "Slowest (2×)"
msgstr "सबसे धीमा (2×)"

msgid "History started"
msgstr "इतिहास शुरू हुआ"

msgid "Added {}"
msgstr "{} जोड़ा गया"

msgid "Removed {}"
msgstr "{} हटाया गया"

msgid "Games"
msgstr "गेम"

msgid "Music"
msgstr "संगीत"

msgid "Video"
msgstr "वीडियो"

msgid "Photos"
msgstr "फ़ोटो"

msgid "Social"
msgstr "सोशल"

msgid "News"
msgstr "समाचार"

msgid "Maps"
msgstr "मैप"

msgid "Productivity"
msgstr "उत्पादकता"

msgid "Accessibility"
msgstr "सुलभता"

msgid "Folder"
msgstr "फ़ोल्डर"

msgid "Type a name, then press ✓. Back keeps the old one."
msgstr "नाम लिखें, फिर ✓ दबाएं। वापस पुराना नाम रखता है।"

msgid "Move past the edge to take the app out. OK drops it."
msgstr "ऐप निकालने के लिए किनारे से आगे जाएं। OK उसे रखता है।"

msgid "Back closes the folder. Up reaches its name."
msgstr "वापस फ़ोल्डर बंद करता है। ऊपर उसके नाम पर जाता है।"

msgid "Made the folder {}"
msgstr "फ़ोल्डर {} बनाया"

msgid "Removed the folder {}"
msgstr "फ़ोल्डर {} हटाया"

msgid "Renamed the folder {} to {}"
msgstr "फ़ोल्डर {} का नाम {} किया"

msgid "Put {} in {}"
msgstr "{} को {} में रखा"

msgid "Took {} out of {}"
msgstr "{} को {} से निकाला"

# RustTV Remote (REMOTE.md)
msgid "RustTV Remote"
msgstr "RustTV Remote"

msgid "Use a phone as a remote, keyboard and touchpad. It can press keys and type, but never change settings or approve anything."
msgstr "फ़ोन को रिमोट, कीबोर्ड और टचपैड की तरह इस्तेमाल करें। यह बटन दबा सकता है और टाइप कर सकता है, पर कभी सेटिंग नहीं बदलता और कुछ भी स्वीकृत नहीं करता।"

msgid "Pair a phone"
msgstr "फ़ोन जोड़ें"

msgid "Shows a code to scan with the phone's camera"
msgstr "फ़ोन के कैमरे से स्कैन करने के लिए कोड दिखाता है"

msgid "Press OK again to remove it"
msgstr "हटाने के लिए फिर से OK दबाएं"

msgid "OK removes it"
msgstr "OK से हटाएं"

msgid "RustTV Remote can't start: another app uses its network port (8484)."
msgstr "RustTV Remote शुरू नहीं हो सकता: कोई और ऐप इसका नेटवर्क पोर्ट (8484) इस्तेमाल कर रहा है।"

msgid "This TV has no network address. Connect it to your network and try again."
msgstr "इस टीवी का कोई नेटवर्क पता नहीं है। इसे अपने नेटवर्क से जोड़ें और फिर कोशिश करें।"

msgid "Pairing stopped after three wrong tries. Back returns; open Pair a phone again for a new code."
msgstr "तीन गलत कोशिशों के बाद जोड़ना रोका गया। लौटने के लिए 'वापस' दबाएं; नया कोड पाने के लिए 'फ़ोन जोड़ें' फिर खोलें।"

msgid "Couldn't make the code."
msgstr "कोड नहीं बन सका।"

msgid "Removed {}. It can't control this TV any more."
msgstr "{} हटाया गया। अब यह इस टीवी को नियंत्रित नहीं कर सकता।"

msgid "OK allows this phone. Back refuses."
msgstr "OK इस फ़ोन को अनुमति देता है। 'वापस' मना करता है।"

msgid "Back returns."
msgstr "लौटने के लिए 'वापस' दबाएं।"

msgid "Scan this code with your phone's camera and open the link.\n\nThe phone must be on the same network as this TV. The code works once, for two minutes."
msgstr "इस कोड को फ़ोन के कैमरे से स्कैन करें और लिंक खोलें।\n\nफ़ोन उसी नेटवर्क पर होना चाहिए जिस पर यह टीवी है। कोड एक बार, दो मिनट तक काम करता है।"

msgid "Allow “{}”?"
msgstr "“{}” को अनुमति दें?"

msgid "Check that the phone shows the same code:"
msgstr "जांचें कि फ़ोन पर वही कोड दिख रहा है:"

msgid "It will be able to press keys and type on this TV. It can never change settings or approve anything."
msgstr "यह इस टीवी पर बटन दबा सकेगा और टाइप कर सकेगा। यह कभी सेटिंग नहीं बदलेगा और कुछ भी स्वीकृत नहीं करेगा।"

msgid "“{}” is paired."
msgstr "“{}” जुड़ गया।"

msgid "Trust this TV"
msgstr "इस टीवी पर भरोसा करें"

msgid "“{}” is installing this TV's certificate, “{}”."
msgstr "“{}” इस टीवी का प्रमाणपत्र “{}” इंस्टॉल कर रहा है।"

msgid "Before installing, check on the phone that its SHA-256 fingerprint starts with:"
msgstr "इंस्टॉल करने से पहले फ़ोन पर जांचें कि उसका SHA-256 फ़िंगरप्रिंट इससे शुरू होता है:"

msgid "If it doesn't match, don't install it: someone on your network may be interfering."
msgstr "अगर मेल नहीं खाता, तो इंस्टॉल न करें: आपके नेटवर्क पर कोई दखल दे रहा हो सकता है।"

msgid "Pointer in other apps"
msgstr "दूसरे ऐप्स में पॉइंटर"

msgid "Off · OK opens Accessibility: turn on RustTV Pointer there"
msgstr "बंद · OK सुलभता खोलता है: वहाँ RustTV Pointer चालू करें"

msgid "On · the phone's touchpad moves a pointer in other apps · OK opens Accessibility"
msgstr "चालू · फ़ोन का टचपैड दूसरे ऐप्स में पॉइंटर हिलाता है · OK सुलभता खोलता है"

msgid "Not on this device"
msgstr "इस डिवाइस पर उपलब्ध नहीं"
