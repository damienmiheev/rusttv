msgid "Checking for updates…"
msgstr "Procurando atualizações…"

msgid "Up to date"
msgstr "Atualizado"

msgid "Version {} available — press OK to install"
msgstr "Versão {} disponível — pressione OK para instalar"

msgid "Allow RustTV to install apps, then press OK to install {}"
msgstr "Permita que o RustTV instale apps e pressione OK para instalar {}"

msgid "Downloading {}%"
msgstr "Baixando {}%"

msgid "Installing…"
msgstr "Instalando…"

msgid "Update installed"
msgstr "Atualização instalada"

msgid "Update failed: {}"
msgstr "Falha na atualização: {}"

msgid "Press OK to check for updates"
msgstr "Pressione OK para procurar atualizações"

msgid "Hide from Home"
msgstr "Ocultar da tela inicial"

msgid "Move"
msgstr "Mover"

msgid "Couldn't open {}"
msgstr "Não foi possível abrir {}"

msgid "Couldn't load apps: {}"
msgstr "Não foi possível carregar os apps: {}"

msgid "Couldn't load the licence notices: {}"
msgstr "Não foi possível carregar os avisos de licença: {}"

msgid "About RustTV"
msgstr "Sobre o RustTV"

msgid "Hidden apps"
msgstr "Apps ocultos"

msgid "About"
msgstr "Sobre"

msgid "OK puts the app back on Home. Back returns."
msgstr "OK coloca o app de volta na tela inicial. Voltar para retornar."

msgid "Version {} · MIT OR Apache-2.0"
msgstr "Versão {} · MIT OR Apache-2.0"

msgid "Built with Slint under the Slint Royalty-free License 2.0. Also includes Skia (BSD-3-Clause) and Rust libraries under MIT or Apache-2.0."
msgstr "Criado com Slint sob a Slint Royalty-free License 2.0. Também inclui Skia (BSD-3-Clause) e bibliotecas Rust sob MIT ou Apache-2.0."

msgid "Source: github.com/damienmiheev/rusttv"
msgstr "Código-fonte: github.com/damienmiheev/rusttv"

msgid "Up and Down scroll the notices. Back returns."
msgstr "Para cima e Para baixo rolam os avisos. Voltar para retornar."

msgid "Third-party notices"
msgstr "Avisos de terceiros"

msgid "Updates"
msgstr "Atualizações"

msgid "History"
msgstr "Histórico"

msgid "Waiting for your computer"
msgstr "Aguardando o computador"

msgid "Animations"
msgstr "Animações"

msgid "Faster (0.5×)"
msgstr "Mais rápido (0,5×)"

msgid "Off"
msgstr "Desativado"

msgid "Normal"
msgstr "Normal"

msgid "On"
msgstr "Ativado"

msgid "Transition animations"
msgstr "Animações de transição"

msgid "Window animations"
msgstr "Animações de janela"

msgid "App animations"
msgstr "Animações de apps"

msgid "off"
msgstr "desativado"

msgid "not seen"
msgstr "não encontrado"

msgid "on"
msgstr "ativado"

msgid "default"
msgstr "padrão"

msgid "Your computer"
msgstr "Seu computador"

msgid "Changed outside RustTV"
msgstr "Alterado fora do RustTV"

msgid "Restored from your computer"
msgstr "Restaurado do seu computador"

msgid "This TV"
msgstr "Esta TV"

msgid "time unknown"
msgstr "horário desconhecido"

msgid "Apps reordered"
msgstr "Apps reordenados"

msgid "Hid {}"
msgstr "Ocultado: {}"

msgid "Showed {}"
msgstr "Exibido: {}"

msgid "Check for updates: {}"
msgstr "Verificar atualizações: {}"

msgid "{}: {} → {}"
msgstr "{}: {} → {}"

msgid "Firmware updated"
msgstr "Firmware atualizado"

msgid "Home takeover: {}"
msgstr "Substituir tela inicial: {}"

msgid "No change"
msgstr "Nenhuma alteração"

msgid "Your computer applies these: run rusttv history apply-pending within 2 hours"
msgstr "Seu computador aplica estas: execute rusttv history apply-pending em até 2 horas"

msgid "This TV changes now"
msgstr "Esta TV muda agora"

msgid "To change this on the TV itself, run rusttv history allow-tv-settings on your computer once. Until then your computer applies it."
msgstr "Para alterar isso na própria TV, execute rusttv history allow-tv-settings uma vez no seu computador. Até lá, o seu computador aplica a alteração."

msgid "Some apps may look odd without animations."
msgstr "Alguns apps podem ficar estranhos sem animações."

msgid "No changes yet. Changes made here or from your computer appear here."
msgstr "Nenhuma alteração ainda. Alterações feitas na TV ou pelo seu computador aparecem aqui."

msgid "{} (+{} more)"
msgstr "{} (+{} mais)"

msgid "Restore this state"
msgstr "Restaurar este estado"

msgid "Check for updates automatically"
msgstr "Verificar atualizações automaticamente"

msgid "{} min"
msgstr "{} min"

msgid "{} h {} min"
msgstr "{} h {} min"

msgid "On your computer, run rusttv history apply-pending within {}."
msgstr "No seu computador, execute rusttv history apply-pending em até {}."

msgid "Applied."
msgstr "Aplicado."

msgid "Saved for your computer. {}"
msgstr "Salvo para o seu computador. {}"

msgid "Nothing changed: {}"
msgstr "Nada foi alterado: {}"

msgid "Nothing changed: wrong code."
msgstr "Nada foi alterado: código errado."

msgid "Too many wrong codes. Approvals are locked for {}."
msgstr "Muitos códigos errados. Aprovações bloqueadas por {}."

msgid "Approvals are off in test builds."
msgstr "As aprovações ficam desativadas em versões de teste."

msgid "Busy — try again in a moment."
msgstr "Ocupado — tente de novo em instantes."

msgid "Couldn't undo everything: {}. Fix it with rusttv history restore on your computer, or in Android Settings."
msgstr "Não foi possível desfazer tudo: {}. Corrija com rusttv history restore no seu computador ou nas configurações do Android."

msgid "This is the state now: nothing to restore."
msgstr "Este já é o estado atual: nada a restaurar."

msgid "Your computer has a newer RustTV. Update RustTV on this TV."
msgstr "Seu computador tem um RustTV mais novo. Atualize o RustTV nesta TV."

msgid "Reading history…"
msgstr "Lendo o histórico…"

msgid "History couldn't be read: {}. Your computer's copy can put it back."
msgstr "Não foi possível ler o histórico: {}. A cópia do seu computador pode restaurá-lo."

msgid "Settings"
msgstr "Configurações"

msgid "Up and Down choose, OK opens. Back returns."
msgstr "Para cima e Para baixo escolhem, OK abre. Voltar para retornar."

msgid "Review changes"
msgstr "Revisar alterações"

msgid "Up and Down read the changes. Choose Approve to go on. Back cancels."
msgstr "Para cima e Para baixo leem as alterações. Escolha Aprovar para continuar. Voltar para cancelar."

msgid "Nothing changes until you hold OK. Back cancels."
msgstr "Nada muda até você manter OK pressionado. Voltar para cancelar."

msgid "Approve"
msgstr "Aprovar"

msgid "Press these arrows on the remote:"
msgstr "Pressione estas setas no controle remoto:"

msgid "Now hold OK to apply."
msgstr "Agora mantenha OK pressionado para aplicar."

msgid "Fastest (0.25×)"
msgstr "Mais rápida (0,25×)"

msgid "Fast (0.75×)"
msgstr "Rápida (0,75×)"

msgid "Slower (1.5×)"
msgstr "Mais lenta (1,5×)"

msgid "Slowest (2×)"
msgstr "A mais lenta (2×)"

msgid "History started"
msgstr "Histórico iniciado"

msgid "Added {}"
msgstr "{} adicionado"

msgid "Removed {}"
msgstr "{} removido"

msgid "Games"
msgstr "Jogos"

msgid "Music"
msgstr "Música"

msgid "Video"
msgstr "Vídeo"

msgid "Photos"
msgstr "Fotos"

msgid "Social"
msgstr "Social"

msgid "News"
msgstr "Notícias"

msgid "Maps"
msgstr "Mapas"

msgid "Productivity"
msgstr "Produtividade"

msgid "Accessibility"
msgstr "Acessibilidade"

msgid "Folder"
msgstr "Pasta"

msgid "Type a name, then press ✓. Back keeps the old one."
msgstr "Digite um nome e pressione ✓. Voltar mantém o antigo."

msgid "Move past the edge to take the app out. OK drops it."
msgstr "Passe da borda para tirar o app. OK solta."

msgid "Back closes the folder. Up reaches its name."
msgstr "Voltar fecha a pasta. Para cima chega ao nome."

msgid "Made the folder {}"
msgstr "Pasta {} criada"

msgid "Removed the folder {}"
msgstr "Pasta {} removida"

msgid "Renamed the folder {} to {}"
msgstr "Pasta {} renomeada para {}"

msgid "Put {} in {}"
msgstr "{} colocado em {}"

msgid "Took {} out of {}"
msgstr "{} tirado de {}"
