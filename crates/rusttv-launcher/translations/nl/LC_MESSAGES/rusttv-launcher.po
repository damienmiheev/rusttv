msgstr "Versie {} beschikbaar — druk op OK om te installeren"

msgid "Allow RustTV to install apps, then press OK to install {}"
msgstr "Sta RustTV toe apps te installeren en druk dan op OK om {} te installeren"

msgid "Downloading {}%"
msgstr "Downloaden: {}%"

msgid "Installing…"
msgstr "Installeren…"

msgid "Update installed"
msgstr "Update geïnstalleerd"

