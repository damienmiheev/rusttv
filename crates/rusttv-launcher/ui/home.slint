// RustTV home screen: layout and motion. Rust owns state (src/ui.rs).
// All sizes are reference pixels on a 1920×1080 canvas, multiplied by `u`.
// Rust owns all state (focus, scroll, mode, timers); this file only draws it
// and forwards keys.

import { Dir, Hints, Theme } from "theme.slint";
// Generated by build.rs: the pictures panel tiles may show, and those
// Home provides for panel pages.
import { Badges } from "badges.slint";
import { Pictures } from "pictures.slint";
// Generated from templates/*.json by build.rs (PANELS.md § 4.1).
import { AboutTile } from "about_tile.slint";
import { AboutListRow } from "about_row.slint";
import { AboutPage } from "about_page.slint";
import { RemoteTile } from "remote_tile.slint";
import { RemoteListRow } from "remote_row.slint";
import { RemotePage } from "remote_page.slint";
import { HistoryTile } from "history_tile.slint";
import { HistoryListRow } from "history_row.slint";
// The status corner's glyphs, the banners and the idle screen's lines
// (PANELS.md § 2), each a global of functions ui/faces_view.rs calls.
import { AboutCorner } from "about_corner.slint";
import { RemoteCorner } from "remote_corner.slint";
import { HistoryCorner } from "history_corner.slint";
import { AboutBanner } from "about_banner.slint";
import { RemoteBanner } from "remote_banner.slint";
import { HistoryBanner } from "history_banner.slint";
import { AboutAmbient } from "about_ambient.slint";
import { RemoteAmbient } from "remote_ambient.slint";
import { HistoryAmbient } from "history_ambient.slint";
import { MenuRow } from "blocks.slint";
import { SettingsRow, ControlRow, QuickBar, QuickPanel, PowerMenu, TextPromptView, VolumeOsd } from "quick.slint";

// The hero backdrop: a dark base and a soft glow of the app's main colour
// (platform.rs `Glow`); x and y place the glow, 0..1 of the screen.
export struct Glow {
    // The whole backdrop, baked small by ui.rs (`Glow::paint`); the other
    // fields describe it.
    backdrop: image,
    base: color,
    color: color,
    x: float,
    y: float,
    strength: float,
}

export struct TileData {
    label: string,
    image: image,
    // 0 banner, 1 icon only, 2 no artwork, 3 the built-in About tile, 4 loading,
    // 5 the Hidden apps tile, 6 the Settings tile, 7 a folder, 8 the RustTV
    // Remote tile, 9 History's tile.
    kind: int,
    // A folder's first four tiles (banners or icons; a built-in tile's
    // banner), drawn small on its tile.
    minis: [image],
}

// One row of a Settings panel: `SettingsRow` in quick.slint.
export { SettingsRow }
export { Dir, Badges, Pictures, Hints, AboutListRow, HistoryListRow, RemoteListRow }
export { AboutCorner, RemoteCorner, HistoryCorner, AboutBanner, RemoteBanner, HistoryBanner, AboutAmbient, RemoteAmbient, HistoryAmbient }

// The About panel's values (src/panels.rs `about_view`), one source for
// every face that shows them: the tile, its hero copy and the page. A name
// means the same value on every face.
export global AboutPanel {
    in property <string> version;
    // The tile's caption: "", "update", "downloading" or "installing".
    in property <string> status;
    // The page's updater line: its state ("idle", "checking", …) and the
    // version, percent or reason it names.
    in property <string> update;
    in property <string> update-detail;
}

// The RustTV Remote panel's tile values (src/panels.rs `remote_view`): how
// many phones are paired ("0", "1", …), and "pairing" while pairing is
// open, else "". Set when the remote's events change them, never per frame.
export global RemotePanel {
    in property <string> phones: "0";
    in property <string> status;
}

// History's tile and row values (src/panels.rs `history_view`): "waiting"
// while an approval waits for the computer, else the last change's age as
// "now", "minutes", "hours" or "days" with that number in `count`; ""
// until the history thread has read the history. Set on resume, focus
// changes and the history's answers, never per frame or by a timer.
export global HistoryPanel {
    in property <string> status;
    in property <string> count: "0";
}

// One line of the review screen; `header` lines name a group.
export struct ReviewLine {
    text: string,
    header: bool,
}

// Texts that Rust puts together (ui.rs), translated here like the rest
// (translations/, @tr). Kind and item values match ui.rs.
export global Strings {
    // ui.rs `update_line`: 0 idle, 1 checking, 2 up to date, 3 available,
    // 4 needs permission, 5 downloading, 6 installing, 7 installed, 8 failed.
    public pure function update-line(kind: int, detail: string) -> string {
        if kind == 1 { return @tr("Checking for updates…"); }
        if kind == 2 { return @tr("Up to date"); }
        // The version is an isolated left-to-right run (U+2066 … U+2069), as
        // on the About page (templates/about_page.json `ltr`).
        if kind == 3 { return @tr("Version {} available — press OK to install", "\u{2066}" + detail + "\u{2069}"); }
        if kind == 4 { return @tr("Allow RustTV to install apps, then press OK to install {}", "\u{2066}" + detail + "\u{2069}"); }
        if kind == 5 { return @tr("Downloading {}%", detail); }
        if kind == 6 { return @tr("Installing…"); }
        if kind == 7 { return @tr("Update installed"); }
        if kind == 8 { return @tr("Update failed: {}", detail); }
        return @tr("Press OK to check for updates");
    }
    // model.rs `Category::ALL`: a new folder's first name.
    public pure function folder-name(category: int) -> string {
        if category == 0 { return @tr("Games"); }
        if category == 1 { return @tr("Music"); }
        if category == 2 { return @tr("Video"); }
        if category == 3 { return @tr("Photos"); }
        if category == 4 { return @tr("Social"); }
        if category == 5 { return @tr("News"); }
        if category == 6 { return @tr("Maps"); }
        if category == 7 { return @tr("Productivity"); }
        if category == 8 { return @tr("Accessibility"); }
        return @tr("Folder");
    }
    // ui.rs `menu_label`: 0 move, 1 hide.
    public pure function menu-label(item: int) -> string {
        if item == 1 { return @tr("Hide from Home"); }
        return @tr("Move");
    }
    // The app's size on screen (its UI scale), in percent.
    public pure function menu-size(percent: string) -> string {
        return @tr("Size: {} %", percent);
    }
    // The app overlay (holding Home over an app; ui.rs `overlay_texts`):
    // 0 size, 1 volume, 2 muted, 3 close, 4 the restart hint.
    public pure function overlay-text(item: int) -> string {
        if item == 1 { return @tr("Volume"); }
        if item == 2 { return @tr("Muted"); }
        if item == 3 { return @tr("Close app"); }
        if item == 4 { return @tr("The app restarts at the new size"); }
        return @tr("Size");
    }
    public pure function couldnt-open(app: string) -> string {
        return @tr("Couldn't open {}", app);
    }
    public pure function couldnt-load-apps(error: string) -> string {
        return @tr("Couldn't load apps: {}", error);
    }
    public pure function couldnt-load-notices(error: string) -> string {
        return @tr("Couldn't load the licence notices: {}", error);
    }
    // Settings and history (HISTORY.md § 8). Values match ui.rs.
    public pure function section-name(section: int) -> string {
        if section == 1 { return @tr("Updates"); }
        if section == 2 { return @tr("History"); }
        if section == 3 { return @tr("Waiting for your computer"); }
        if section == 4 { return @tr("Effects"); }
        if section == 5 { return @tr("About"); }
        if section == 6 { return @tr("Idle screen"); }
        return @tr("Animations");
    }
    // Settings' About tab (ui/settings_view.rs `AboutRow`): the Source row's
    // title. (Its Updates row is named like the Updates section; its RustTV
    // row is About's row face, templates/about_row.json.)
    public pure function source-code() -> string {
        return @tr("Source code");
    }
    // settings.rs ANIMATION_CHOICES: off to slowest.
    public pure function animation-choice(choice: int) -> string {
        if choice == 0 { return @tr("Off"); }
        if choice == 1 { return @tr("Fastest (0.25×)"); }
        if choice == 2 { return @tr("Faster (0.5×)"); }
        if choice == 3 { return @tr("Fast (0.75×)"); }
        if choice == 5 { return @tr("Slower (1.5×)"); }
        if choice == 6 { return @tr("Slowest (2×)"); }
        return @tr("Normal");
    }
    // The RustTV Remote page (REMOTE.md § 2; its note is in
    // templates/remote_page.json).
    public pure function pair-phone() -> string {
        return @tr("Pair a phone");
    }
    public pure function pair-phone-detail() -> string {
        return @tr("Shows a code to scan with the phone's camera");
    }
    // The pointer's accessibility service (REMOTE.md § 5): 0 not on this
    // device, 1 off, 2 on.
    public pure function pointer-row() -> string {
        return @tr("Pointer in other apps");
    }
    public pure function pointer-detail(state: int) -> string {
        if state == 1 { return @tr("Off · OK opens Accessibility: turn on RustTV Pointer there"); }
        if state == 2 { return @tr("On · the phone's touchpad moves a pointer in other apps · OK opens Accessibility"); }
        return @tr("Not on this device");
    }
    public pure function phone-detail(removing: bool) -> string {
        return removing ? @tr("Press OK again to remove it") : @tr("OK removes it");
    }
    public pure function pairing-failure(kind: int) -> string {
        if kind == 1 { return @tr("RustTV Remote can't start: another app uses its network port (8484)."); }
        if kind == 2 { return @tr("This TV has no network address. Connect it to your network and try again."); }
        if kind == 4 { return @tr("Pairing stopped after three wrong tries. Back returns; open Pair a phone again for a new code."); }
        return @tr("Couldn't make the code.");
    }
    public pure function on-off(on: bool) -> string {
        return on ? @tr("On") : @tr("Off");
    }
    // Settings' Effects section (settings.rs `Section::Effects`).
    public pure function effects-choice(reduced: bool) -> string {
        return reduced ? @tr("Reduced") : @tr("Full");
    }
    public pure function effects-detail(reduced: bool) -> string {
        return reduced ? @tr("No shadows or backdrop: smoother on a slow graphics chip") : @tr("Shadows and backdrop");
    }
    // Settings' Idle screen section (settings.rs `Section::Ambient`): what
    // On does (ui.rs AMBIENT_AFTER); Off needs no words.
    public pure function ambient-detail(on: bool) -> string {
        return on ? @tr("After 5 minutes on Home, a dim clock until you press a key") : "";
    }
    // SETTING_KEYS order: animator, transition, window.
    public pure function setting-name(key: int) -> string {
        if key == 1 { return @tr("Transition animations"); }
        if key == 2 { return @tr("Window animations"); }
        return @tr("App animations");
    }
    // 0 enabled, 1 disabled, 2 not seen.
    public pure function package-state(state: int) -> string {
        if state == 1 { return @tr("off"); }
        if state == 2 { return @tr("not seen"); }
        return @tr("on");
    }
    public pure function unset-value() -> string {
        return @tr("default");
    }
    // 0 this TV, 1 the computer, 2 outside RustTV, 3 put back from the computer.
    public pure function who(author: int) -> string {
        if author == 1 { return @tr("Your computer"); }
        if author == 2 { return @tr("Changed outside RustTV"); }
        if author == 3 { return @tr("Restored from your computer"); }
        return @tr("This TV");
    }
    public pure function time-unknown() -> string {
        return @tr("time unknown");
    }
    // A built-in tile's name in the change list (model.rs `name_of`), as its
    // tile shows it; "" for any other name.
    public pure function builtin-name(name: string) -> string {
        if name == "about" { return @tr("About"); }
        if name == "settings" { return @tr("Settings"); }
        if name == "remote" { return @tr("RustTV Remote"); }
        if name == "panel:history" { return @tr("History"); }
        return "";
    }
    // ui.rs `change_line`: 0 reordered, 1 hid, 2 showed, 3 update check,
    // 4 setting, 5 package, 6 firmware, 7 Home takeover, 8 nothing,
    // 9 added to Home (installed), 10 removed from Home, 11 folder made,
    // 12 folder removed, 13 folder renamed (old → new), 14 app put in a
    // folder (name; old: the folder), 15 app taken out of a folder, 16
    // phone paired, 17 phone removed, 18 effects, 19 idle screen.
    public pure function change-line(kind: int, name: string, old: string, new: string) -> string {
        if kind == 0 { return @tr("Apps reordered"); }
        if kind == 1 { return @tr("Hid {}", name); }
        if kind == 2 { return @tr("Showed {}", name); }
        if kind == 3 { return @tr("Check for updates: {}", new); }
        if kind == 4 || kind == 5 { return @tr("{}: {} → {}", name, old, new); }
        if kind == 6 { return @tr("Firmware updated"); }
        if kind == 7 { return @tr("Home takeover: {}", new); }
        if kind == 9 { return @tr("Added {}", name); }
        if kind == 10 { return @tr("Removed {}", name); }
        if kind == 11 { return @tr("Made the folder {}", name); }
        if kind == 12 { return @tr("Removed the folder {}", name); }
        if kind == 13 { return @tr("Renamed the folder {} to {}", old, new); }
        if kind == 14 { return @tr("Put {} in {}", name, old); }
        if kind == 15 { return @tr("Took {} out of {}", name, old); }
        if kind == 16 { return @tr("Paired the phone {}", name); }
        if kind == 17 { return @tr("Removed the phone {}", name); }
        if kind == 18 { return @tr("Effects: {}", new); }
        if kind == 19 { return @tr("Idle screen: {}", new); }
        return @tr("No change");
    }
    // 0 changed on the TV now, 1 applied by the computer later.
    public pure function review-group(group: int) -> string {
        if group == 1 { return @tr("Your computer applies these: run rusttv history apply-pending within 2 hours"); }
        return @tr("This TV changes now");
    }
    public pure function grant-hint() -> string {
        return @tr("To change this on the TV itself, run rusttv history allow-tv-settings on your computer once. Until then your computer applies it.");
    }
    public pure function off-note() -> string {
        return @tr("Some apps may look odd without animations.");
    }
    public pure function history-empty() -> string {
        return @tr("No changes yet. Changes made here or from your computer appear here.");
    }
    public pure function and-more(line: string, more: int) -> string {
        return @tr("{} (+{} more)", line, more);
    }
    public pure function history-started() -> string {
        return @tr("History started");
    }
    public pure function restore-this() -> string {
        return @tr("Restore this state");
    }
    public pure function update-check-title() -> string {
        return @tr("Check for updates automatically");
    }
    public pure function duration(hours: int, minutes: int) -> string {
        if hours == 0 { return @tr("{} min", minutes); }
        return @tr("{} h {} min", hours, minutes);
    }
    public pure function run-apply-pending(time: string) -> string {
        return @tr("On your computer, run rusttv history apply-pending within {}.", time);
    }
    // ui.rs `settings_status`: 0 none, 1 applied, 2 saved for the computer,
    // 3 nothing changed (detail), 4 wrong code, 5 locked (detail: time),
    // 6 test build, 7 busy, 8 rollback failed (detail), 9 nothing to restore,
    // 10 newer format, 11 reading, 12 history unreadable (detail).
    public pure function settings-status(kind: int, detail: string) -> string {
        if kind == 1 { return @tr("Applied."); }
        if kind == 2 { return @tr("Saved for your computer. {}", detail); }
        if kind == 3 { return @tr("Nothing changed: {}", detail); }
        if kind == 4 { return @tr("Nothing changed: wrong code."); }
        if kind == 5 { return @tr("Too many wrong codes. Approvals are locked for {}.", detail); }
        if kind == 6 { return @tr("Approvals are off in test builds."); }
        if kind == 7 { return @tr("Busy — try again in a moment."); }
        if kind == 8 { return @tr("Couldn't undo everything: {}. Fix it with rusttv history restore on your computer, or in Android Settings.", detail); }
        if kind == 9 { return @tr("This is the state now: nothing to restore."); }
        if kind == 10 { return @tr("Your computer has a newer RustTV. Update RustTV on this TV."); }
        if kind == 11 { return @tr("Reading history…"); }
        if kind == 12 { return @tr("History couldn't be read: {}. Your computer's copy can put it back.", detail); }
        if kind == 13 { return @tr("Removed {}. It can't control this TV any more.", detail); }
        return "";
    }
}

// The mouse pointer over RustTV: hidden while the D-pad is used and after a
// while without moving (ui.rs `pointer_moved`, `key`).
export global Pointer {
    in property <bool> shown: true;
}

// Mode values, kept in sync with `mode_value` in ui.rs.
// Settings → Effects (ui.rs `apply_effects`): Reduced turns the costly
// parts off for a weak GPU. The defaults are the normal look.
export global Effects {
    in property <bool> shadows: true;
    in property <bool> backdrop: true;
    // The hero backdrop as one baked picture (`Glow.backdrop`) instead of
    // drawn gradients: set where there is a top-right menu (Linux).
    in property <bool> baked-backdrop: false;
}

global Mode {
    out property <int> browse: 0;
    out property <int> moving: 1;
    out property <int> launching: 2;
    out property <int> about: 3;
    out property <int> menu: 4;
    out property <int> hidden: 5;
    out property <int> settings: 6;
    out property <int> review: 7;
    out property <int> folder: 8;
    out property <int> pairing: 9;
    out property <int> remote: 10;
    // Focus in the top-right menu; a quick panel open over Home.
    out property <int> bar: 11;
    out property <int> quick: 12;
}

// Picture or placeholder for one app, filling its parent.
component Artwork inherits Rectangle {
    in property <TileData> data;
    in property <length> u;
    background: Theme.surface;

    // Pictures fade in: on a TV they arrive after the first frame (kind 4,
    // loading, is an empty card until then). The built-in tiles (5, 6) have
    // banners too; About (3), RustTV Remote (8) and History (9) are panels,
    // drawn from their templates below.
    Image {
        width: parent.width;
        height: parent.height;
        source: data.image;
        image-fit: cover;
        opacity: data.kind == 0 || data.kind == 5 || data.kind == 6 ? 1 : 0;
        animate opacity { duration: 300ms; easing: ease-out; }
    }
    Image {
        y: parent.height * 0.15;
        width: 72 * u;
        height: 72 * u;
        x: (parent.width - self.width) / 2;
        source: data.image;
        image-fit: contain;
        opacity: data.kind == 1 ? 1 : 0;
        animate opacity { duration: 300ms; easing: ease-out; }
    }
    // The About panel's tile face, scaled to the card (the template is 250 u
    // wide), so the hero draws the same tile larger.
    if data.kind == 3: AboutTile {
        u: parent.width / 250;
        // The template is 250 × 141 u; the hero's box is a little shorter.
        height: parent.height;
        version: AboutPanel.version;
        status: AboutPanel.status;
    }
    // The RustTV Remote panel's tile face, the same way.
    if data.kind == 8: RemoteTile {
        u: parent.width / 250;
        height: parent.height;
        phones: RemotePanel.phones;
        status: RemotePanel.status;
    }
    // History's tile face, the same way.
    if data.kind == 9: HistoryTile {
        u: parent.width / 250;
        height: parent.height;
        status: HistoryPanel.status;
        count: HistoryPanel.count;
    }
    // A folder: its first four apps in a 2 × 2 grid on the card, like a
    // small Home.
    if data.kind == 7: Rectangle {
        property <length> pad: parent.width * 0.04;
        property <length> gap: parent.width * 0.024;
        property <length> cell-w: (parent.width - 2 * self.pad - self.gap) / 2;
        property <length> cell-h: (parent.height - 2 * self.pad - self.gap) / 2;
        for mini[k] in data.minis: Rectangle {
            x: Dir.x(parent.pad + mod(k, 2) * (parent.cell-w + parent.gap), parent.cell-w, parent.width);
            y: parent.pad + floor(k / 2) * (parent.cell-h + parent.gap);
            width: parent.cell-w;
            height: parent.cell-h;
            border-radius: root.height * 0.045;
            clip: true;
            background: Theme.bg.with-alpha(0.5);
            Image {
                width: parent.width;
                height: parent.height;
                source: mini;
                image-fit: cover;
            }
        }
    }
    if data.kind == 1 || data.kind == 2: Text {
        y: data.kind == 1 ? parent.height * 0.15 + 80 * u : 0;
        width: parent.width;
        height: data.kind == 1 ? 32 * u : parent.height;
        text: data.label;
        font-size: 23 * u;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component Tile inherits Rectangle {
    in property <TileData> data;
    in property <length> u;
    in property <int> index;
    in property <bool> focused;
    in property <int> mode;
    in property <bool> pressed;
    // 0 active, 1 swaying (the focused tile, after a short idle).
    in property <int> idle-phase;
    // A dot in the corner: set on the Settings tile while an update is available.
    in property <bool> badge;
    // A pointer (mouse, air mouse) entered the tile; clicked it (`menu`: the
    // secondary button, as a long OK press).
    callback hovered();
    callback clicked(/* menu */ bool);
    // The wheel turned over the tile: down is positive.
    callback scrolled(length);

    property <bool> browsing: mode == Mode.browse;
    property <bool> sway: focused && browsing && !pressed && idle-phase == 1;
    property <bool> jiggle: mode == Mode.moving;
    property <bool> launching: focused && mode == Mode.launching;
    property <float> scale: launching ? 1.6
        : !focused ? 1.0
        : pressed && browsing ? 1.075
        : 1.15;
    // How much the tile sways, 0..1. Animated, so the sway grows from rest and
    // fades out again instead of jumping to wherever the phase happens to be.
    // It fades out only when the focused tile goes still after the idle time;
    // losing focus, pressing OK or launching stops it at once.
    property <float> sway-amount: sway ? 1 : 0;
    animate sway-amount {
        duration: sway || (focused && browsing && !pressed) ? 1200ms : 0ms;
        easing: ease-in-out;
    }
    // Phase in turns; evaluated only while it is used, so a still screen does not redraw.
    property <float> sway-turns: sway-amount > 0 ? animation-tick() / 4s : 0;
    property <float> jiggle-turns: jiggle ? animation-tick() / 325ms + index * 0.37 : 0;

    width: 250 * u;
    height: 141 * u;
    z: focused ? 1 : 0;

    // Focus scale is done by resizing around the centre rather than with
    // transform-scale: Slint's software renderer (desktop dev mode) ignores
    // transforms. Rotation and shadows show only with Skia (the TV).
    property <float> zoom: scale;
    animate zoom {
        duration: launching ? 500ms : focused ? 150ms : 250ms;
        easing: launching ? cubic-bezier(0.25, 0.1, 0.25, 1) : focused ? ease-out : ease-in-out;
    }
    // The zoom the card is drawn at: a copy of `zoom` set only when its
    // value changes. `zoom` is marked changed whenever anything it reads
    // changes (the mode, on every page that opens or closes), and the card's
    // size passes that on to the panel faces' cached layers
    // (`cache-rendering-hint`), which then drew again, all at once, in the
    // frame a page opened.
    property <float> card-zoom;
    init => { self.card-zoom = self.zoom; }
    changed zoom => { self.card-zoom = self.zoom; }

    card := Rectangle {
        width: parent.width * card-zoom;
        height: parent.height * card-zoom;
        x: (parent.width - self.width) / 2 + (jiggle ? 1 * u * sin(jiggle-turns * 360deg + 90deg)
            : sway-amount * 3 * u * sin(sway-turns * 360deg + 90deg));
        y: (parent.height - self.height) / 2 + (jiggle ? 1.5 * u * sin(jiggle-turns * 720deg)
            : sway-amount * 3 * u * sin(sway-turns * 360deg));
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: jiggle ? 1.6deg * sin(jiggle-turns * 360deg)
            : sway-amount * 1.5deg * sin(sway-turns * 360deg);
        opacity: launching ? 0 : 1;
        border-radius: 12 * u;
        drop-shadow-color: !Effects.shadows ? transparent : focused ? #00000080 : #00000040;
        drop-shadow-blur: !Effects.shadows ? 0 : focused ? 40 * u : 8 * u;
        drop-shadow-offset-y: -sway-amount * 3 * u * sin(sway-turns * 360deg) + (focused ? 20 * u : 4 * u);

        animate opacity { duration: 500ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        animate drop-shadow-blur, drop-shadow-color { duration: focused ? 150ms : 250ms; }

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            clip: true;

            Artwork {
                width: parent.width;
                height: parent.height;
                data: root.data;
                u: root.u;
            }

            // Sheen: a faint light band sliding across while the tile sways.
            if sway-amount > 0: Rectangle {
                width: parent.width * 0.6;
                height: parent.height;
                opacity: sway-amount;
                x: parent.width * (0.2 + 0.45 * sin(sway-turns * 360deg));
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffff1f 50%, #ffffff00 100%);
            }
        }

        // The update dot. Not animated, so it adds no frames to the home screen.
        if badge: Rectangle {
            x: Dir.x(parent.width - self.width - 14 * u, self.width, parent.width);
            y: 14 * u;
            width: 18 * u;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent;
        }

        // The focused tile's ring (the accent while moving it), so focus
        // shows at a glance, not only by the zoom.
        if focused && !launching: Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            border-width: 4 * u;
            border-color: jiggle ? Theme.accent : Theme.text;
        }
    }

    // Pointer input over the tile's resting place (not its zoom, so
    // neighbours don't fight over the overlap). Hover counts only when the
    // pointer itself moves, so tiles scrolling under a still pointer don't
    // take focus from the D-pad.
    TouchArea {
        mouse-cursor: Pointer.shown ? MouseCursor.pointer : MouseCursor.none;
        clicked => {
            root.clicked(false);
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered();
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.clicked(true);
            }
        }
        scroll-event(event) => {
            root.scrolled(-event.delta-y);
            accept
        }
    }

    // Name under the focused tile only. Slint has no text shadow, so a dark copy
    // offset by (0, 2) stands in for a soft label shadow.
    label-shadow := Text {
        x: 0;
        y: parent.height + 24 * u + 2 * u;
        width: parent.width;
        text: data.kind == 3 ? @tr("About") : data.kind == 5 ? @tr("Hidden apps") : data.kind == 6 ? @tr("Settings") : data.kind == 8 ? @tr("RustTV Remote") : data.kind == 9 ? @tr("History") : data.label;
        font-size: 25 * u;
        font-weight: 500;
        color: #00000066;
        horizontal-alignment: center;
        overflow: elide;
        opacity: focused && !launching && data.kind != 1 && data.kind != 2 ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    Text {
        x: 0;
        y: parent.height + 24 * u;
        width: parent.width;
        text: label-shadow.text;
        font-size: 25 * u;
        font-weight: 500;
        color: Theme.text;
        horizontal-alignment: center;
        overflow: elide;
        opacity: label-shadow.opacity;
    }
}

// The focused app's picture above the grid. Two of these cross-fade.
component HeroLayer inherits Rectangle {
    in property <TileData> data;
    in property <Glow> glow;
    in property <length> u;
    // How much it shows, 0..1. Set on each part rather than as the layer's
    // opacity: that would render the whole screen into an extra layer on
    // every frame of a cross-fade, more than a weak TV GPU manages at 60 fps.
    in property <float> fade: 1;
    // The backdrop's own fade (see the cross-fade in HomeWindow).
    in property <float> backdrop-fade: 1;

    // With `Effects.baked-backdrop` (Linux) the backdrop is one small baked
    // picture, scaled up: the same look as drawing its gradients, at a
    // fraction of the cost on a weak GPU. Never a full-screen bitmap per app
    // (up to ~20 MB each on a TV). It ends where it has faded into the page
    // colour (`Glow::HEIGHT`, platform.rs): the page shows the rest.
    Image {
        y: 0;
        width: parent.width;
        height: 780 * root.u;
        source: glow.backdrop;
        image-fit: fill;
        image-rendering: smooth;
        opacity: root.backdrop-fade;
        visible: Effects.baked-backdrop && Effects.backdrop && root.backdrop-fade > 0;
    }
    // Otherwise drawn, not an image: a full-screen backdrop bitmap per app
    // cost up to ~20 MB on a TV. The glow is a circle as wide as the screen,
    // centred where the main colour sits in the app's banner.
    Rectangle {
        opacity: root.backdrop-fade;
        visible: !Effects.baked-backdrop && root.backdrop-fade > 0;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: glow.base;
        }
        Rectangle {
            width: parent.width * 1.3;
            height: self.width;
            x: (Dir.rtl ? 1 - glow.x : glow.x) * parent.width - self.width / 2;
            y: glow.y * parent.height - self.height / 2;
            opacity: glow.strength;
            visible: Effects.backdrop;
            background: @radial-gradient(circle, glow.color 0%, glow.color.with-alpha(0.45) 30%, glow.color.with-alpha(0) 70%);
        }
        // Scrim on the text side, so the backdrop can keep its colour on the right.
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 780 * root.u;
            background: @linear-gradient(Dir.rtl ? 270deg : 90deg, #0E1014D9 0%, #0E101466 40%, #0E101400 70%);
        }
        Rectangle {
            y: 400 * root.u;
            height: 380 * root.u;
            background: @linear-gradient(180deg, #0E101400 0%, Theme.bg 100%);
        }
        Rectangle {
            y: 780 * root.u;
            height: parent.height - self.y;
            background: Theme.bg;
        }
    }
    Rectangle {
        x: Dir.x(90 * u, self.width, parent.width);
        y: 360 * u;
        width: 448 * u;
        height: 252 * u;
        border-radius: 16 * u;
        clip: true;
        opacity: root.fade;
        visible: root.fade > 0;
        Artwork {
            width: parent.width;
            height: parent.height;
            data: root.data;
            u: root.u;
        }
    }
    Text {
        x: Dir.x(90 * u, self.width, parent.width);
        y: 640 * u;
        width: 1740 * u;
        horizontal-alignment: Dir.start;
        text: data.kind == 3 ? "RustTV" : data.kind == 5 ? @tr("Hidden apps") : data.kind == 6 ? @tr("Settings") : data.kind == 8 ? @tr("RustTV Remote") : data.kind == 9 ? @tr("History") : data.label;
        font-size: 57 * u;
        font-weight: 500;
        color: Theme.text;
        overflow: elide;
        opacity: root.fade;
        visible: root.fade > 0;
    }
}

// Home's status corner (PANELS.md § 2, § 9 Q2): the clock, and before it
// (on the start side) at most two glyphs of panels that need attention
// (their `corner` templates' badges, ui/faces_view.rs). Not focusable; the
// clock's text changes once a minute, nothing moves in between.
component StatusCorner inherits Rectangle {
    in property <length> u;
    in property <string> clock;
    in property <[image]> glyphs;

    property <length> glyph: 40 * u;
    property <length> gap: 20 * u;
    height: 72 * u;
    width: clock-text.preferred-width + glyphs.length * (glyph + gap);

    for picture[i] in glyphs: Image {
        x: Dir.x(i * (root.glyph + root.gap), root.glyph, root.width);
        y: (root.height - root.glyph) / 2;
        width: root.glyph;
        height: root.glyph;
        source: picture;
        image-fit: contain;
    }
    clock-text := Text {
        x: Dir.x(root.width - self.preferred-width, self.preferred-width, root.width);
        width: self.preferred-width;
        height: root.height;
        text: clock;
        font-size: 33 * u;
        font-weight: 500;
        color: Theme.text;
        vertical-alignment: center;
    }
}

// A panel's banner (PANELS.md § 9 Q4): a card that slides in at the top
// end side under the status corner for about four seconds, one at a time
// (ui/faces_view.rs queues them). Never focusable; no shadow and no slide
// with reduced effects (it only fades).
component BannerCard inherits Rectangle {
    in property <length> u;
    in property <bool> shown;
    in property <string> title;
    in property <string> detail;
    in property <image> badge;
    // The drop shadow (`banner-shadow`, build.rs `banner_shadow`), drawn
    // for a typical card and stretched to this one.
    in property <image> shadow;

    property <length> pad: 24 * u;
    property <length> picture: 64 * u;
    property <length> text-width: min(720 * u, max(title-text.preferred-width, detail-text.preferred-width));
    // How much it shows, 0..1. Set on each part rather than as the card's
    // opacity: with its parts (and a drop shadow) under it, that renders
    // the whole screen into an extra layer on every frame of the fade, as
    // HeroLayer says; each part alone fades by its own alpha. The shadow is
    // three pictures for the same reason: one Slint draws would have to be
    // in that layer to fade with the card.
    property <float> fade: shown ? 1 : 0;
    animate fade { duration: shown ? 300ms : 250ms; easing: ease-out; }
    // The shadow's blur, also its padding around the card.
    property <length> blur: 40 * u;
    width: self.pad * 2 + self.picture + 24 * u + self.text-width;
    height: self.pad * 2 + self.picture;
    visible: self.fade > 0;

    // `visible` here, not on the picture: on an element with `opacity` it
    // puts one more element between, and the fade needs a layer again.
    Rectangle {
        visible: Effects.shadows;
        Image {
            x: -root.blur;
            y: -root.blur + 16 * u;
            width: root.width + 2 * root.blur;
            height: root.height + 2 * root.blur;
            source: root.shadow;
            image-fit: fill;
            opacity: root.fade;
        }
    }
    Rectangle {
        width: root.width;
        height: root.height;
        border-radius: 24 * u;
        background: Theme.surface;
        opacity: root.fade;
    }
    Image {
        x: Dir.x(root.pad, root.picture, root.width);
        y: root.pad;
        width: root.picture;
        height: root.picture;
        source: badge;
        image-fit: contain;
        opacity: root.fade;
    }
    title-text := Text {
        x: Dir.x(root.pad + root.picture + 24 * u, root.text-width, root.width);
        y: root.pad + (detail == "" ? (root.picture - self.height) / 2 : 0);
        width: root.text-width;
        height: 36 * u;
        horizontal-alignment: Dir.start;
        vertical-alignment: center;
        text: title;
        font-size: 29 * u;
        font-weight: 500;
        color: Theme.text;
        overflow: elide;
        opacity: root.fade;
    }
    // No `visible: detail != ""`: an empty text draws nothing anyway.
    detail-text := Text {
        x: Dir.x(root.pad + root.picture + 24 * u, root.text-width, root.width);
        y: root.pad + 36 * u;
        width: root.text-width;
        height: 30 * u;
        horizontal-alignment: Dir.start;
        vertical-alignment: center;
        text: detail;
        font-size: 25 * u;
        color: Theme.text-dim;
        overflow: elide;
        opacity: root.fade;
    }
}

// One panel's line on the idle screen (its `ambient` template).
export struct AmbientLine {
    badge: image,
    text: string,
}

// The idle screen (PANELS.md § 9 Q6): black, a large dim clock and the
// panels' lines under it. OLED care: nothing bright (the clock is dim
// text, pictures half shown), and the whole face moves a little every
// minute (`drift`, a step ui/faces_view.rs sets with the clock: a jump,
// never an animation, so nothing is drawn between minutes). It takes the
// pointer, so a move or a click wakes Home instead of reaching a tile.
component AmbientFace inherits Rectangle {
    in property <length> u;
    in property <bool> shown;
    in property <string> clock;
    in property <[AmbientLine]> lines;
    in property <int> drift;
    callback woken();

    // Five by five places around the centre, one a minute.
    property <length> dx: (mod(drift, 5) - 2) * 20 * u;
    property <length> dy: (mod(floor(drift / 5), 5) - 2) * 14 * u;
    property <length> line-pitch: 56 * u;
    property <length> group-height: 200 * u + lines.length * line-pitch;

    background: #000000;
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0;
    // Home dims into it slowly; a key brings Home back at once.
    // With reduced effects it comes at once: a full-screen blend for over
    // a second is the costliest frame on a weak GPU.
    animate opacity { duration: shown && Effects.shadows ? 1200ms : 0ms; easing: ease-in-out; }

    TouchArea {
        enabled: root.shown;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move || event.kind == PointerEventKind.down {
                root.woken();
            }
        }
        scroll-event(event) => {
            root.woken();
            accept
        }
    }
    Text {
        y: (root.height - root.group-height) / 2 + root.dy;
        width: root.width;
        height: 200 * u;
        x: root.dx;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: clock;
        font-size: 180 * u;
        font-weight: 300;
        color: Theme.text-dim;
        opacity: 0.6;
    }
    for line[i] in lines: Rectangle {
        property <length> line-width: 40 * u + 16 * u + line-text.preferred-width;
        x: (root.width - self.line-width) / 2 + root.dx;
        y: (root.height - root.group-height) / 2 + 200 * u + i * root.line-pitch + root.dy;
        width: self.line-width;
        height: 40 * u;
        Image {
            x: Dir.x(0, 40 * u, parent.width);
            width: 40 * u;
            height: 40 * u;
            source: line.badge;
            image-fit: contain;
            opacity: 0.5;
        }
        line-text := Text {
            x: Dir.x(56 * u, self.preferred-width, parent.width);
            height: 40 * u;
            vertical-alignment: center;
            text: line.text;
            font-size: 29 * u;
            color: Theme.text-dim;
            opacity: 0.6;
        }
    }
}

export component HomeWindow inherits Window {
    in property <[TileData]> tiles;
    in property <int> focused-index;
    in property <bool> shelf: true;
    in property <int> first-row;
    in property <int> mode;
    in property <bool> pressed;
    in property <int> idle-phase;
    in property <TileData> hero-a;
    in property <Glow> hero-a-glow;
    in property <TileData> hero-b;
    in property <Glow> hero-b-glow;
    in property <bool> hero-a-front: true;
    in property <string> toast;
    // The status corner (ui/faces_view.rs): the clock ("14:05"), set once
    // a minute while Home is on screen, and the glyphs of panels that need
    // attention (at most two).
    in property <string> clock-text;
    in property <[image]> corner-glyphs;
    // The banner over Home: shown while `banner-shown`; its words stay
    // while it fades out.
    in property <bool> banner-shown;
    in property <string> banner-title;
    in property <string> banner-detail;
    in property <image> banner-badge;
    // Its drop shadow, blurred beforehand (build.rs `banner_shadow`).
    in property <image> banner-shadow;
    // The idle screen, its panels' lines and its drift step.
    in property <bool> ambient-shown;
    in property <[AmbientLine]> ambient-lines;
    in property <int> ambient-drift;
    callback ambient-woken();
    // Whether an update waits to be installed (a dot on the Settings tile).
    in property <bool> update-available;
    // A slice of the licence notices from the line at the top of the panel
    // (ui.rs `Notices`), how far they are scrolled (0..1) and the share shown.
    in property <string> notices;
    in property <float> notices-position;
    in property <float> notices-fraction: 1;
    // The long-press menu of the focused tile (ui.rs `menu_label`); empty when closed.
    in property <[string]> menu-items;
    in property <int> menu-selected;
    // The selected menu item's marquee (ui.rs `schedule_marquee`): its text
    // slides to its end while this is true and back while false. How long one
    // slide takes for it; 0 when it fits.
    in property <bool> menu-marquee-end;
    // Measured at the 1920-wide size (27px, not 27 * u): text width scales
    // with font size, so `u` cancels out, and the measure doesn't depend on
    // the window's size (which would be a binding loop).
    out property <duration> menu-marquee-time: max(0px, menu-measure.preferred-width - (380 - 16 - 48) * 1px) / 60px * 1s;
    // The hidden apps page.
    in property <[TileData]> hidden-tiles;
    in property <int> hidden-focus;
    // The Settings page (ui.rs `render_settings`): sections on the left, the
    // selected one's panel on the right. `settings-row` is the focused panel
    // row, -1 while the section list has focus.
    // The sections, in Settings' row look: History's has the last change's
    // age as its detail and the accent dot while an approval waits (its row
    // face, templates/history_row.json).
    in property <[SettingsRow]> settings-sections;
    in property <int> settings-section;
    in property <int> settings-row: -1;
    in property <string> settings-panel-title;
    // The device's settings are being read (ui/settings_view.rs): a spinner.
    in property <bool> settings-loading;
    in property <string> settings-note;
    in property <[SettingsRow]> settings-rows;
    // The first row shown (long lists scroll by rows).
    in property <int> settings-first-row;
    in property <string> settings-status;
    // The RustTV Remote page (ui.rs `render_remote_page`): "Pair a phone",
    // then the paired phones. `remote-row` is the focused row.
    in property <[SettingsRow]> remote-rows;
    in property <int> remote-row;
    in property <int> remote-first-row;
    // The review screen (ui.rs `render_review`). Phase 0: reading, the row
    // after the last line is Approve; 1: the code; 2: hold OK.
    in property <[ReviewLine]> review-lines;
    in property <int> review-row;
    in property <int> review-first-line;
    in property <int> review-phase;
    // The code's four arrows (0 up, 1 down, 2 left, 3 right) and how many
    // were pressed; `review-holding` while OK is held.
    in property <[int]> review-code;
    in property <int> review-entered;
    in property <bool> review-holding;
    // The pairing screen (ui/remote_view.rs). Phase 0: the QR code is
    // shown; 1: a phone asks ("Allow?" and the code); 2: paired; 3: failed;
    // 4: a phone sets up trust (`pairing-address` is then the certificate's
    // name, `pairing-code` its check code).
    in property <int> pairing-phase;
    in property <image> pairing-qr;
    in property <string> pairing-address;
    in property <string> pairing-name;
    in property <string> pairing-code;
    // ui/remote_view.rs: 1 port taken, 2 no address, 3 no code, 4 three wrong tries.
    in property <int> pairing-failure;
    // While an app moves on Home: the tile it is on top of, drawn under it
    // in its slot until the next key; -1 for none.
    in property <int> over-index: -1;
    // The open folder (ui.rs `render_folder`): its apps, the focused one
    // (-1: its name), its name. `folder-tiles` stays filled while it closes.
    in property <bool> folder-open;
    in property <[TileData]> folder-tiles;
    in property <int> folder-focus;
    in property <string> folder-name;
    // Renaming the open folder: the name field has focus instead of `keys`.
    in property <bool> renaming;
    in-out property <string> rename-text;
    callback rename-done(string);
    callback rename-cancelled();
    // The top-right menu (ui/device_view.rs): its entries as `QuickBar`
    // codes, the focused one (-1: focus is on the tiles).
    in property <[int]> quick-actions;
    in property <int> quick-selected: -1;
    // The open quick panel (mode quick): its title, status line, rows, the
    // focused row and the first row shown.
    in property <string> quick-title;
    in property <string> quick-status;
    in property <[SettingsRow]> quick-rows;
    in property <int> quick-row;
    in property <int> quick-first-row;
    // The open panel is Power: it shows full screen (quick.slint `PowerMenu`).
    in property <bool> quick-power;
    // A click on a row of the open quick panel, or beside the power menu.
    callback quick-row-clicked(int);
    callback quick-dismissed();
    // The text prompt (quick.slint `TextPromptView`, ui/device_view.rs).
    in property <bool> prompt-shown;
    // Frames drawn in the last second (`RUSTTV_FPS=1`, ui.rs `count_frames`);
    // empty hides it.
    in property <string> fps-text;
    in property <string> prompt-title;
    in property <bool> prompt-secret;
    in-out property <string> prompt-text;
    callback prompt-done(string);
    callback prompt-cancelled();
    // The volume bar (ui/device_view.rs `show_volume`).
    in property <bool> volume-shown;
    in property <float> volume-level;
    in property <bool> volume-muted;
    // Key text, pressed (false = released), repeat. Returns whether it was used.
    callback key(string, bool, bool) -> bool;
    // Pointer input (mouse, air mouse): on tile `index` of Home (`folder`
    // false) or of the open folder, `action` 0 hovered, 1 clicked, 2 the
    // secondary button (its menu).
    callback tile-pointer(/* folder */ bool, /* index */ int, /* action */ int);
    // Pointer input on Settings: on section `index` (`panel` false) or on
    // row `index` of its panel, `action` 0 hovered, 1 clicked.
    callback settings-pointer(/* panel */ bool, /* index */ int, /* action */ int);
    // Pointer input on a list (ui.rs `list_pointer`): item `index` of
    // `list` (0 the tile menu, 1 Hidden apps, 2 RustTV Remote, 3 the quick
    // panel or power menu, 4 review), `action` 0 hovered, 1 clicked.
    callback list-pointer(/* list */ int, /* index */ int, /* action */ int);
    // The pointer over entry `index` of the top-right menu.
    callback quick-hovered(int);
    // A click on entry `index` of the top-right menu.
    callback quick-clicked(int);
    // The wheel: positive scrolls down.
    callback scrolled(length);
    // The pointer moved somewhere off the tiles.
    callback pointer-moved();
    // The network interfaces on the top-right menu's Network entry
    // (quick.slint `QuickBar.links`).
    in property <[int]> network-icons;

    public function focus-rename() {
        rename-input.focus();
        rename-input.select-all();
    }
    public function focus-keys() {
        keys.focus();
    }

    property <length> u: self.width / 1920;

    title: "RustTV";
    forward-focus: keys;
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.bg;

    // Measures the selected menu item's text for `menu-marquee-time`; never drawn.
    menu-measure := Text {
        visible: false;
        text: menu-items[menu-selected];
        font-size: 27px;
        font-weight: 500;
    }

    // The pointer and the wheel over empty space (tiles report their own).
    TouchArea {
        mouse-cursor: Pointer.shown ? MouseCursor.default : MouseCursor.none;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-moved();
            }
        }
        scroll-event(event) => {
            root.scrolled(-event.delta-y);
            accept
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            root.key(event.text, true, event.repeat) ? accept : reject
        }
        key-released(event) => {
            root.key(event.text, false, false) ? accept : reject
        }
    }

    // The hero cross-fade. Title and card cross-fade both ways. Of the two
    // full-screen backdrops only B's ever fades, and always over an opaque A:
    // B fades in over A, or A shows the new picture at once and B fades out
    // over it. So a frame blends at most one full-screen picture, and the
    // layers never change order (a `z` change redraws the whole screen).
    // A is hidden while B covers it, so a still home draws one backdrop.
    property <float> shelf-fade: shelf ? 1 : 0;
    animate shelf-fade { duration: 250ms; }
    property <float> hero-a-fade: hero-a-front ? 1 : 0;
    animate hero-a-fade { duration: 250ms; }
    property <float> hero-b-fade: hero-a-front ? 0 : 1;
    animate hero-b-fade { duration: 250ms; }
    property <float> hero-b-backdrop: hero-a-front ? 0 : 1;
    animate hero-b-backdrop { duration: 250ms; }

    HeroLayer {
        data: hero-a;
        glow: hero-a-glow;
        u: root.u;
        fade: root.hero-a-fade * root.shelf-fade;
        backdrop-fade: root.hero-b-backdrop < 1 ? root.shelf-fade : 0;
    }
    HeroLayer {
        data: hero-b;
        glow: hero-b-glow;
        u: root.u;
        fade: root.hero-b-fade * root.shelf-fade;
        backdrop-fade: root.hero-b-backdrop * root.shelf-fade;
    }

    // All rows; the whole grid moves to scroll (§3 "Two scroll states").
    Rectangle {
        y: shelf ? 800 * u : (90 - first-row * 251) * u;
        height: 0;
        animate y { duration: 250ms; easing: ease-out; }

        for tile[i] in tiles: Tile {
            // The tile under a moving app is drawn in the app's slot; the
            // app sits a little off it, so both show.
            property <int> slot: i == over-index ? focused-index : i;
            property <length> nudge: i == focused-index && over-index >= 0 ? 28 * u : 0;
            x: Dir.x((90 + mod(self.slot, 6) * 298) * u + self.nudge, 250 * u, root.width);
            y: floor(self.slot / 6) * 251 * u + self.nudge * 0.75;
            // Tiles glide to their new place when a move reorders them.
            animate x, y { duration: 250ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
            data: tile;
            u: root.u;
            index: i;
            // Focus is on the top-right menu or its panel instead.
            focused: i == focused-index && root.mode != Mode.bar && root.mode != Mode.quick;
            mode: root.mode == Mode.folder ? Mode.browse : root.mode;
            pressed: root.pressed && !root.folder-open;
            idle-phase: root.folder-open ? 0 : root.idle-phase;
            // About is a tab of Settings, so Settings has the update dot;
            // the About tile shows its own caption (AboutPanel).
            badge: tile.kind == 6 && root.update-available;
            // The open folder's own tile: the panel grew out of it.
            opacity: root.folder-open && i == focused-index ? 0 : 1;
            hovered => { root.tile-pointer(false, i, 0); }
            clicked(menu) => { root.tile-pointer(false, i, menu ? 2 : 1); }
            scrolled(delta) => { root.scrolled(delta); }
        }
    }

    // The top-right menu (quick.slint), shown with the hero; Up from the
    // first row reaches it. Its quick panel opens below it.
    quick-bar := QuickBar {
        x: Dir.x(root.width - 90 * u - self.width, self.width, root.width);
        y: 48 * u;
        u: root.u;
        rtl: Dir.rtl;
        actions: quick-actions;
        selected: quick-selected;
        links: network-icons;
        opacity: shelf ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 250ms; }
        clicked(index) => { root.quick-clicked(index); }
        hovered(index) => { root.quick-hovered(index); }
    }
    // The status corner: at the top end like the top-right menu, before it
    // where there is one, and shown with the hero, as the menu is.
    StatusCorner {
        property <length> end: 90 * u + (quick-bar.width > 0 ? quick-bar.width + 40 * u : 0);
        x: Dir.x(root.width - self.end - self.width, self.width, root.width);
        y: 48 * u;
        u: root.u;
        clock: clock-text;
        glyphs: corner-glyphs;
        opacity: shelf ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: 250ms; }
    }
    // A panel's banner, at the top end under the status corner; it slides
    // in from the end edge (it only fades with reduced effects). Under
    // everything that opens over Home (quick panels, folders, menus, pages),
    // so one fading out as they open is covered at once.
    BannerCard {
        property <length> slide: banner-shown || !Effects.shadows ? 0 : 48 * u;
        animate slide { duration: banner-shown ? 300ms : 250ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
        x: Dir.x(root.width - 90 * u - self.width + self.slide, self.width, root.width);
        y: 150 * u;
        u: root.u;
        shown: banner-shown;
        title: banner-title;
        detail: banner-detail;
        badge: banner-badge;
        shadow: banner-shadow;
    }

    if mode == Mode.quick && !quick-power: QuickPanel {
        x: Dir.x(root.width - 90 * u - self.width, self.width, root.width);
        y: 190 * u;
        u: root.u;
        rtl: Dir.rtl;
        title: quick-title;
        status: quick-status;
        rows: quick-rows;
        focused-row: quick-row;
        first-row: quick-first-row;
        row-clicked(row) => { root.quick-row-clicked(row); }
        row-hovered(row) => { root.list-pointer(3, row, 0); }
    }
    if mode == Mode.quick && quick-power: PowerMenu {
        width: root.width;
        height: root.height;
        u: root.u;
        title: quick-title;
        status: quick-status;
        rows: quick-rows;
        focused-row: quick-row;
        row-clicked(row) => { root.quick-row-clicked(row); }
        row-hovered(row) => { root.list-pointer(3, row, 0); }
        dismissed => { root.quick-dismissed(); }
    }

    // An open folder: Home dims, and the folder grows out of its tile into a
    // panel with its name above (the panel's geometry animates; its apps fade
    // in once it has room). Closing shrinks it back into the tile.
    folder-scrim := Rectangle {
        background: Theme.bg.with-alpha(0.72);
        opacity: folder-open ? 1 : 0;
        animate opacity { duration: folder-open ? 300ms : 250ms; easing: ease-out; }
    }
    // Pages of 12 (model.rs FOLDER_PAGE), side by side; the panel shows the
    // focused app's page and is as tall as its fullest page.
    property <int> folder-rows: max(1, ceil(folder-tiles.length / 4));
    property <int> folder-pages: max(1, ceil(folder-tiles.length / 12));
    property <int> folder-page: floor(max(0, folder-focus) / 12);
    property <length> panel-w: (56 * 2 + 4 * 250 + 3 * 48) * u;
    property <length> panel-h: (56 * 2 + 141 + (min(3, folder-rows) - 1) * 251 + 44) * u;
    property <length> panel-y: 270 * u;
    // The folder's tile on Home, at its focused size.
    property <length> home-tile-x: Dir.x((90 + mod(focused-index, 6) * 298 - 19) * u, 288 * u, root.width);
    property <length> home-tile-y: (shelf ? 800 * u : (90 + (floor(focused-index / 6) - first-row) * 251) * u) - 11 * u;
    folder-panel := Rectangle {
        x: folder-open ? (root.width - root.panel-w) / 2 : root.home-tile-x;
        y: folder-open ? root.panel-y : root.home-tile-y;
        width: folder-open ? root.panel-w : 288 * u;
        height: folder-open ? root.panel-h : 162 * u;
        border-radius: (folder-open ? 28 : 12) * u;
        background: Theme.surface;
        opacity: folder-open ? 1 : 0;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 80 * u;
        drop-shadow-offset-y: 40 * u;
        clip: true;
        animate x, y, width, height, border-radius {
            duration: folder-open ? 300ms : 250ms;
            easing: cubic-bezier(0.2, 0.9, 0.3, 1);
        }
        animate opacity { duration: folder-open ? 100ms : 250ms; easing: ease-out; }

        Rectangle {
            opacity: folder-open ? 1 : 0;
            animate opacity { duration: folder-open ? 200ms : 100ms; delay: folder-open ? 100ms : 0ms; }
            Rectangle {
                x: Dir.x(-root.folder-page * root.panel-w, root.panel-w, root.panel-w);
                width: root.panel-w;
                animate x { duration: 350ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                for tile[i] in folder-tiles: Tile {
                    x: Dir.x(floor(i / 12) * root.panel-w + (56 + mod(i, 4) * 298) * u, 250 * u, root.panel-w);
                    y: (56 + floor(mod(i, 12) / 4) * 251) * u;
                    animate x, y { duration: 250ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
                    data: tile;
                    u: root.u;
                    index: i;
                    focused: root.folder-open && i == root.folder-focus;
                    mode: root.mode == Mode.folder ? Mode.browse : root.mode;
                    pressed: root.pressed;
                    idle-phase: root.idle-phase;
                    hovered => { root.tile-pointer(true, i, 0); }
                    clicked(menu) => { root.tile-pointer(true, i, menu ? 2 : 1); }
                    scrolled(delta) => { root.scrolled(delta); }
                }
            }
        }
    }
    // The name: a light pill while it has focus (OK renames), the name
    // field while renaming.
    Rectangle {
        y: 150 * u;
        height: 76 * u;
        width: (renaming ? max(rename-input.preferred-width, 120 * u) : folder-title.preferred-width) + 56 * u;
        x: (root.width - self.width) / 2;
        border-radius: 12 * u;
        background: (folder-focus < 0 || renaming) && folder-open ? Theme.text : Theme.text.with-alpha(0);
        opacity: folder-open ? 1 : 0;
        animate opacity { duration: folder-open ? 300ms : 150ms; easing: ease-out; }
        animate background { duration: 120ms; }
        folder-title := Text {
            visible: !renaming;
            text: folder-name;
            font-size: 57 * u;
            font-weight: 500;
            color: folder-focus < 0 && folder-open ? Theme.bg : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
        FocusScope {
            visible: renaming;
            enabled: renaming;
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == "\u{F748}" {
                    root.rename-cancelled();
                    return accept;
                }
                reject
            }
            rename-input := TextInput {
                x: 28 * u;
                width: max(self.preferred-width, 120 * u);
                height: parent.height;
                text <=> root.rename-text;
                single-line: true;
                font-size: 57 * u;
                font-weight: 500;
                color: Theme.bg;
                horizontal-alignment: center;
                vertical-alignment: center;
                accepted => {
                    root.rename-done(self.text);
                }
            }
        }
    }
    // Page dots, as on a phone: the current page light, the others dim.
    if folder-open && folder-pages > 1: Rectangle {
        y: root.panel-y + root.panel-h + 32 * u;
        height: 12 * u;
        width: (folder-pages * 28 - 16) * u;
        x: (root.width - self.width) / 2;
        for page[p] in folder-pages: Rectangle {
            x: Dir.x(p * 28 * u, 12 * u, parent.width);
            width: 12 * u;
            height: 12 * u;
            border-radius: 6 * u;
            background: p == root.folder-page ? Theme.text : Theme.text-dim.with-alpha(0.4);
            animate background { duration: 200ms; }
        }
    }
    if folder-open: Text {
        x: 0;
        y: renaming ? 240 * u : root.panel-y + root.panel-h + (folder-pages > 1 ? 76 : 40) * u;
        width: root.width;
        horizontal-alignment: center;
        text: renaming ? @tr("Type a name, then press ✓. Back keeps the old one.")
            : mode == Mode.moving ? @tr("Move past the edge to take the app out. OK drops it.")
            : Hints.keys ? @tr("Back closes the folder. Up reaches its name.") : "";
        font-size: 25 * u;
        color: Theme.text-dim;
    }

    // Long-press menu, beside the focused tile: to its right in the first four
    // columns, else to its left. Fades in; closes at once. In an open folder,
    // beside the focused app in the panel.
    Rectangle {
        property <int> column: folder-open ? mod(max(0, folder-focus), 4) : mod(focused-index, 6);
        property <length> tile-x: folder-open
            ? (root.width - root.panel-w) / 2 + (56 + column * 298) * u
            : (90 + column * 298) * u;
        property <length> tile-y: folder-open
            ? root.panel-y + (56 + floor(mod(max(0, folder-focus), 12) / 4) * 251) * u
            : shelf ? 800 * u : (90 + (floor(focused-index / 6) - first-row) * 251) * u;
        width: 380 * u;
        height: (menu-items.length * 64 + 16) * u;
        // 19 is how far the focused tile grows past its slot on each side.
        x: Dir.x(column < (folder-open ? 2 : 4) ? self.tile-x + (250 + 19 + 24) * u : self.tile-x - (19 + 24) * u - self.width, self.width, root.width);
        y: self.tile-y + (141 * u - self.height) / 2;
        opacity: mode == Mode.menu ? 1 : 0;
        animate opacity { duration: mode == Mode.menu ? 150ms : 0ms; easing: ease-out; }
        border-radius: 16 * u;
        background: Theme.surface;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 40 * u;
        drop-shadow-offset-y: 20 * u;

        for item[i] in menu-items: Rectangle {
            x: 8 * u;
            y: (8 + i * 64) * u;
            width: parent.width - 16 * u;
            height: 64 * u;
            border-radius: 10 * u;
            background: i == menu-selected ? Theme.text : Theme.text.with-alpha(0);
            animate background { duration: 120ms; }
            TouchArea {
                enabled: mode == Mode.menu;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.list-pointer(0, i, 0);
                    }
                }
                clicked => { root.list-pointer(0, i, 1); }
            }
            // A text too long for the menu (some translations) is cut with
            // "…". While its item is selected it slides to its end and back,
            // paced by ui.rs (`menu-marquee-end`), so a menu that fits adds
            // no frames.
            Rectangle {
                x: 24 * u;
                width: parent.width - 48 * u;
                clip: true;
                property <length> overflow: max(0px, label.preferred-width - self.width);
                property <bool> sliding: i == menu-selected && mode == Mode.menu && self.overflow > 0;
                property <length> shift: self.sliding && menu-marquee-end ? self.overflow : 0px;
                animate shift { duration: self.overflow / (60 * u) * 1s; easing: ease-in-out; }
                label := Text {
                    // Reads `shift` in every case: Slint evaluates lazily, and a
                    // value first read while it changes jumps instead of
                    // animating. Right-to-left starts at the right end.
                    x: Dir.rtl ? parent.shift - (parent.sliding ? parent.overflow : 0px) : -parent.shift;
                    width: parent.sliding ? self.preferred-width : parent.width;
                    text: item;
                    horizontal-alignment: Dir.start;
                    font-size: 27 * u;
                    font-weight: 500;
                    color: i == menu-selected ? Theme.bg : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    animate color { duration: 120ms; }
                }
                // Soft edges instead of a hard cut: where the text goes on
                // past an edge, that edge fades into the item's colour.
                // Kept off the item's top and bottom: covering its anti-aliased
                // edge there would draw a sharper, higher edge (the text never
                // reaches that far).
                property <length> fade: 32 * u;
                if self.sliding: Rectangle {
                    // The end, while more text is to come.
                    y: 8 * u;
                    height: parent.height - 16 * u;
                    x: Dir.x(parent.width - parent.fade, parent.fade, parent.width);
                    width: parent.fade;
                    opacity: min(1, (parent.overflow - parent.shift) / parent.fade);
                    background: @linear-gradient(Dir.rtl ? 270deg : 90deg, Theme.text.with-alpha(0) 0%, Theme.text 100%);
                }
                if self.sliding: Rectangle {
                    // The start, once the text has slid.
                    y: 8 * u;
                    height: parent.height - 16 * u;
                    x: Dir.x(0px, parent.fade, parent.width);
                    width: parent.fade;
                    opacity: min(1, parent.shift / parent.fade);
                    background: @linear-gradient(Dir.rtl ? 90deg : 270deg, Theme.text.with-alpha(0) 0%, Theme.text 100%);
                }
            }
        }
    }

    // Launch splash: covers Home while the app starts, until its window takes
    // over (or the launch fails). It fades in a little late, so an app that
    // opens at once shows only the tile's zoom. The dots animate only while
    // it is shown, so it costs no frames otherwise.
    splash := Rectangle {
        property <bool> shown: mode == Mode.launching;
        property <TileData> app: folder-open ? folder-tiles[folder-focus] : tiles[focused-index];
        background: Theme.bg;
        opacity: shown ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: shown ? 250ms : 150ms; delay: shown ? 200ms : 0ms; easing: ease-out; }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 300 * u;
            width: 500 * u;
            height: 282 * u;
            border-radius: 20 * u;
            clip: true;
            Artwork {
                width: parent.width;
                height: parent.height;
                data: splash.app;
                u: root.u * 2;
            }
        }
        // Icon cards (kinds 1, 2) already carry the name.
        if splash.app.kind != 1 && splash.app.kind != 2: Text {
            x: 0;
            y: 630 * u;
            width: parent.width;
            text: splash.app.label;
            font-size: 41 * u;
            font-weight: 500;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        for k in 3: Rectangle {
            property <float> phase: splash.visible ? mod(animation-tick() / 1200ms + k * 0.2, 1) : 0;
            x: (parent.width - 3 * 18 * u - 2 * 22 * u) / 2 + k * 40 * u;
            y: 740 * u;
            width: 18 * u;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent;
            opacity: 0.25 + 0.75 * max(0, sin(self.phase * 360deg));
        }
    }

    // Hidden apps: the same tiles on their own page; the grid scrolls by
    // whole rows to keep the focused row among the first three.
    if mode == Mode.hidden: Rectangle {
        background: Theme.bg;

        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 90 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Hidden apps");
            font-size: 57 * u;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 176 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("OK puts it back on Home. Back returns.");
            font-size: 25 * u;
            color: Theme.text-dim;
        }
        Rectangle {
            y: 260 * u;
            height: parent.height - self.y;
            clip: true;

            Rectangle {
                y: (80 - max(0, floor(hidden-focus / 6) - 2) * 251) * u;
                height: 0;
                animate y { duration: 250ms; easing: ease-out; }

                for tile[i] in hidden-tiles: Tile {
                    x: Dir.x((90 + mod(i, 6) * 298) * u, 250 * u, root.width);
                    y: floor(i / 6) * 251 * u;
                    data: tile;
                    u: root.u;
                    index: i;
                    focused: i == hidden-focus;
                    mode: Mode.browse;
                    pressed: false;
                    idle-phase: root.idle-phase;
                    hovered => { root.list-pointer(1, i, 0); }
                    clicked(menu) => {
                        if !menu {
                            root.list-pointer(1, i, 1);
                        }
                    }
                }
            }
        }
    }

    if toast != "": Rectangle {
        x: Dir.x(90 * u, self.width, root.width);
        y: (1020 - 64) * u;
        width: toast-text.preferred-width + 48 * u;
        height: 64 * u;
        border-radius: 12 * u;
        background: Theme.surface;
        toast-text := Text {
            x: 24 * u;
            text: toast;
            font-size: 29 * u;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    // About: who made RustTV on the left, the licence notices on the right
    // (swapped for right-to-left languages). Generated from
    // templates/about_page.json; Home scrolls the notices (ui.rs `Notices`).
    if mode == Mode.about: AboutPage {
        u: root.u;
        version: AboutPanel.version;
        update: AboutPanel.update;
        update-detail: AboutPanel.update-detail;
        scroll-text: notices;
        scroll-position: notices-position;
        scroll-fraction: notices-fraction;
    }
    // Settings (HISTORY.md § 8): the Hidden apps header; the sections as menu
    // rows on the left, the selected one's panel (About's surface) on the
    // right. Appears at once, like About: D-pad actions don't animate.
    if mode == Mode.settings: Rectangle {
        background: Theme.bg;

        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 90 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Settings");
            font-size: 57 * u;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 176 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: settings-status != "" ? settings-status : Hints.keys ? @tr("Up and Down choose, OK opens. Back returns.") : "";
            font-size: 25 * u;
            color: settings-status != "" ? Theme.text : Theme.text-dim;
            overflow: elide;
        }
        if settings-loading: Rectangle {
            x: (parent.width - 72 * u) / 2;
            y: (parent.height - 72 * u) / 2;
            width: 72 * u;
            height: 72 * u;
            // A ring with a gap, turning once a second.
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 12 2 A 10 10 0 1 1 2 12";
                stroke: Theme.text;
                stroke-width: 4 * u;
                fill: transparent;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-rotation: mod(animation-tick(), 1s) / 1s * 360deg;
            }
        }
        if settings-loading: Text {
            x: 0;
            y: (parent.height + 72 * u) / 2 + 24 * u;
            width: parent.width;
            horizontal-alignment: center;
            text: @tr("Loading…");
            font-size: 28 * u;
            color: Theme.text-dim;
        }
        // 8 u apart; a row with a detail is taller (MenuRow), so the rows
        // stack.
        VerticalLayout {
            x: Dir.x(90 * u, self.width, root.width);
            y: 260 * u;
            width: 480 * u;
            height: 760 * u;
            spacing: 8 * u;
            alignment: start;
            for section[i] in settings-sections: Rectangle {
                height: section-row.height;
                section-row := MenuRow {
                    width: parent.width;
                    u: root.u;
                    text: section.title;
                    detail: section.detail;
                    tall: section.tall;
                    current: section.current;
                    selected: i == settings-section && settings-row < 0;
                    marked: i == settings-section && settings-row >= 0;
                }
                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.settings-pointer(false, i, 0);
                        }
                    }
                    clicked => { root.settings-pointer(false, i, 1); }
                }
            }
        }
        Rectangle {
            x: Dir.x(720 * u, self.width, root.width);
            y: 260 * u;
            width: 1110 * u;
            height: 760 * u;
            border-radius: 16 * u;
            background: Theme.surface;
            clip: true;

            Text {
                x: Dir.x(48 * u, self.width, parent.width);
                y: 36 * u;
                width: parent.width - 96 * u;
                horizontal-alignment: Dir.start;
                text: settings-panel-title;
                font-size: 29 * u;
                font-weight: 500;
                color: Theme.text;
                overflow: elide;
            }
            note := Text {
                x: Dir.x(48 * u, self.width, parent.width);
                y: 88 * u;
                width: parent.width - 96 * u;
                horizontal-alignment: Dir.start;
                text: settings-note;
                font-size: 25 * u;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            Rectangle {
                y: (settings-note == "" ? 96 : 120) * u + (settings-note == "" ? 0px : note.preferred-height);
                height: parent.height - self.y - 24 * u;
                clip: true;
                property <length> pitch: (settings-rows.length > 0 && (settings-rows[0].detail != "" || settings-rows[0].slider) ? 104 : 72) * u;
                // Rows of the platform's tabs can be sliders (quick.slint).
                for row[i] in settings-rows: ControlRow {
                    x: 24 * u;
                    y: (i - settings-first-row) * parent.pitch;
                    width: parent.width - 48 * u;
                    u: root.u;
                    rtl: Dir.rtl;
                    text: row.title;
                    detail: row.detail;
                    current: row.current;
                    dim: row.dim;
                    slider: row.slider;
                    level: row.level;
                    selected: i == settings-row;
                    visible: i >= settings-first-row;
                }
                for row[i] in settings-rows: TouchArea {
                    x: 24 * u;
                    y: (i - settings-first-row) * parent.pitch;
                    width: parent.width - 48 * u;
                    height: parent.pitch;
                    visible: i >= settings-first-row;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.settings-pointer(true, i, 0);
                        }
                    }
                    clicked => { root.settings-pointer(true, i, 1); }
                }
            }
        }
    }

    // RustTV Remote (REMOTE.md § 2), from its Home tile. Generated from
    // templates/remote_page.json: Settings' header, the tile's banner and
    // what a phone may do on the start side, the rows (ui.rs
    // `render_remote_page`) in the surface panel. Appears at once, like
    // Settings.
    if mode == Mode.remote: RemotePage {
        u: root.u;
        header-status: settings-status;
        rows-model: remote-rows;
        rows-focus: remote-row;
        rows-first: remote-first-row;
        rows-pointer(index, action) => {
            root.list-pointer(2, index, action);
        }
    }

    // Review and confirm (HISTORY.md § 6.2, § 8.5). Up and Down read the
    // changes; Approve shows the code, pressed with the arrow keys, then OK
    // is held. The window is FLAG_SECURE while this is open (ui.rs), so adb
    // screen captures show black.
    if mode == Mode.review: Rectangle {
        background: Theme.bg;

        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 90 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Review changes");
            font-size: 57 * u;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 176 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: settings-status != "" ? settings-status
                : review-phase == 0 ? @tr("Up and Down read the changes. Choose Approve to go on. Back cancels.")
                : @tr("Nothing changes until you hold OK. Back cancels.");
            font-size: 25 * u;
            color: settings-status != "" ? Theme.text : Theme.text-dim;
            overflow: elide;
        }
        Rectangle {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 260 * u;
            width: 1740 * u;
            height: 520 * u;
            clip: true;
            for line[i] in review-lines: Rectangle {
                y: (i - review-first-line) * 64 * u;
                height: 64 * u;
                visible: i >= review-first-line;
                if line.header: Text {
                    x: Dir.x(0, self.width, parent.width);
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: Dir.start;
                    vertical-alignment: center;
                    text: line.text;
                    font-size: 25 * u;
                    color: Theme.text-dim;
                    overflow: elide;
                }
                if !line.header: MenuRow {
                    width: parent.width;
                    u: root.u;
                    text: line.text;
                    selected: review-phase == 0 && i == review-row;
                }
                if !line.header: TouchArea {
                    enabled: review-phase == 0;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            root.list-pointer(4, i, 0);
                        }
                    }
                    clicked => { root.list-pointer(4, i, 1); }
                }
            }
            MenuRow {
                y: (review-lines.length - review-first-line) * 64 * u;
                width: 480 * u;
                x: Dir.x(0, self.width, parent.width);
                u: root.u;
                text: @tr("Approve");
                selected: review-phase == 0 && review-row == review-lines.length;
                marked: review-phase > 0;
            }
            TouchArea {
                y: (review-lines.length - review-first-line) * 64 * u;
                width: 480 * u;
                height: 64 * u;
                x: Dir.x(0, self.width, parent.width);
                enabled: review-phase == 0;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.list-pointer(4, review-lines.length, 0);
                    }
                }
                clicked => { root.list-pointer(4, review-lines.length, 1); }
            }
        }
        if review-phase >= 1: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 812 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: review-phase == 1 ? @tr("Press these arrows on the remote:") : @tr("Now hold OK to apply.");
            font-size: 27 * u;
            color: Theme.text;
        }
        // The code: always left to right, in every language (the arrow keys
        // keep their physical meaning).
        if review-phase >= 1: Rectangle {
            x: 90 * u;
            y: 860 * u;
            width: 4 * 88 * u;
            height: 76 * u;
            for arrow[k] in review-code: Text {
                x: k * 88 * u;
                width: 76 * u;
                height: 76 * u;
                text: arrow == 0 ? "↑" : arrow == 1 ? "↓" : arrow == 2 ? "←" : "→";
                font-size: 57 * u;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: k < review-entered ? Theme.accent : Theme.text;
            }
        }
        // The hold: fills over 2 s while OK is held, snaps back fast when it
        // is let go (slow where the person decides, fast where it answers).
        if review-phase == 2: Rectangle {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 980 * u;
            width: 600 * u;
            height: 4 * u;
            border-radius: 2 * u;
            background: Theme.surface;
            Rectangle {
                x: Dir.x(0, self.width, parent.width);
                width: review-holding ? parent.width : 0;
                border-radius: parent.border-radius;
                background: Theme.accent;
                animate width {
                    duration: review-holding ? 2000ms : 200ms;
                    easing: review-holding ? linear : ease-out;
                }
            }
        }
    }
    // Pairing a phone (REMOTE.md § 2): the QR code holds the page's address
    // and a one-time secret; a phone that read it asks, and OK on the remote
    // allows it. Phone input never reaches this screen. The window is
    // FLAG_SECURE while it is open, so screen captures don't show the code.
    if mode == Mode.pairing: Rectangle {
        background: Theme.bg;

        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 90 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: pairing-phase == 4 ? @tr("Trust this TV") : @tr("Pair a phone");
            font-size: 57 * u;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 176 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: pairing-phase == 1 ? @tr("OK allows this phone. Back refuses.") : Hints.keys ? @tr("Back returns.") : "";
            font-size: 25 * u;
            color: Theme.text-dim;
            overflow: elide;
        }
        // The code sits on white with a margin, as phone cameras expect.
        if pairing-phase == 0: Rectangle {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 260 * u;
            width: 600 * u;
            height: 600 * u;
            border-radius: 24 * u;
            background: #FFFFFF;

            Image {
                x: 36 * u;
                y: 36 * u;
                width: 528 * u;
                height: 528 * u;
                source: pairing-qr;
                image-rendering: pixelated;
            }
        }
        if pairing-phase == 0: Text {
            x: Dir.x(780 * u, self.width, parent.width);
            y: 280 * u;
            width: 1050 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Scan this code with your phone's camera and open the link.\n\nThe phone must be on the same network as this TV. The code works once, for two minutes.");
            font-size: 33 * u;
            color: Theme.text;
            wrap: word-wrap;
        }
        if pairing-phase == 0: Text {
            x: Dir.x(780 * u, self.width, parent.width);
            y: 820 * u;
            width: 1050 * u;
            horizontal-alignment: Dir.start;
            text: pairing-address;
            font-size: 25 * u;
            color: Theme.text-dim;
        }
        if pairing-phase == 1: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 300 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Allow “{}”?", pairing-name);
            font-size: 57 * u;
            font-weight: 500;
            color: Theme.text;
            overflow: elide;
        }
        if pairing-phase == 1: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 420 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Check that the phone shows the same code:");
            font-size: 33 * u;
            color: Theme.text-dim;
        }
        if pairing-phase == 1: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 490 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: pairing-code;
            font-size: 180 * u;
            font-weight: 700;
            color: Theme.accent;
        }
        if pairing-phase == 1: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 760 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("It will be able to press keys and type on this TV. It can never change settings or approve anything.");
            font-size: 29 * u;
            color: Theme.text;
            wrap: word-wrap;
        }
        if pairing-phase == 4: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 280 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("“{}” is installing this TV's certificate, “{}”.", pairing-name, pairing-address);
            font-size: 41 * u;
            color: Theme.text;
            wrap: word-wrap;
        }
        if pairing-phase == 4: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 420 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Before installing, check on the phone that its SHA-256 fingerprint starts with:");
            font-size: 33 * u;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        if pairing-phase == 4: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 500 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: pairing-code;
            font-size: 120 * u;
            font-weight: 700;
            letter-spacing: 6 * u;
            color: Theme.accent;
        }
        if pairing-phase == 4: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 700 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("If it doesn't match, don't install it: someone on your network may be interfering.");
            font-size: 29 * u;
            color: Theme.text;
            wrap: word-wrap;
        }
        if pairing-phase == 2 || pairing-phase == 3: Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 300 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: pairing-phase == 2 ? @tr("“{}” is paired.", pairing-name) : Strings.pairing-failure(pairing-failure);
            font-size: 41 * u;
            color: Theme.text;
            wrap: word-wrap;
        }
    }

    // The text prompt over Settings.
    if prompt-shown: TextPromptView {
        width: root.width;
        height: root.height;
        u: root.u;
        title: prompt-title;
        secret: prompt-secret;
        text <=> root.prompt-text;
        done(text) => { root.prompt-done(text); }
        cancelled => { root.prompt-cancelled(); }
    }

    // The idle screen, over Home (ui/faces_view.rs enters it only there).
    AmbientFace {
        width: root.width;
        height: root.height;
        u: root.u;
        shown: ambient-shown;
        clock: clock-text;
        lines: ambient-lines;
        drift: ambient-drift;
        woken => { root.ambient-woken(); }
    }

    // The volume bar, over everything (ui/device_view.rs).
    VolumeOsd {
        x: (root.width - self.width) / 2;
        y: 60 * u;
        u: root.u;
        shown: volume-shown;
        level: volume-level;
        muted: volume-muted;
    }
    if fps-text != "": Rectangle {
        x: 16 * u;
        y: 16 * u;
        width: fps-label.preferred-width + 24 * u;
        height: fps-label.preferred-height + 12 * u;
        background: #000000B0;
        border-radius: 8 * u;
        fps-label := Text {
            text: fps-text;
            color: #ffffff;
            font-size: 24 * u;
        }
    }
}
