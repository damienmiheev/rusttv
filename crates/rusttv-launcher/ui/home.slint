// RustTV home screen: layout and motion. Rust owns state (src/ui.rs).
// All sizes are reference pixels on a 1920×1080 canvas, multiplied by `u`.
// Rust owns all state (focus, scroll, mode, timers); this file only draws it
// and forwards keys.

import { AboutSlint } from "std-widgets.slint";

// The hero backdrop: a dark base and a soft glow of the app's main colour
// (platform.rs `Glow`); x and y place the glow, 0..1 of the screen.
export struct Glow {
    base: color,
    color: color,
    x: float,
    y: float,
    strength: float,
}

export struct TileData {
    label: string,
    image: image,
    // 0 banner, 1 icon only, 2 no artwork, 3 the built-in About tile, 4 loading,
    // 5 the Hidden apps tile.
    kind: int,
}

// Texts that Rust puts together (ui.rs), translated here like the rest
// (translations/, @tr). Kind and item values match ui.rs.
export global Strings {
    // ui.rs `update_line`: 0 idle, 1 checking, 2 up to date, 3 available,
    // 4 needs permission, 5 downloading, 6 installing, 7 installed, 8 failed.
    public pure function update-line(kind: int, detail: string) -> string {
        if kind == 1 { return @tr("Checking for updates…"); }
        if kind == 2 { return @tr("Up to date"); }
        if kind == 3 { return @tr("Version {} available — press OK to install", detail); }
        if kind == 4 { return @tr("Allow RustTV to install apps, then press OK to install {}", detail); }
        if kind == 5 { return @tr("Downloading {}%", detail); }
        if kind == 6 { return @tr("Installing…"); }
        if kind == 7 { return @tr("Update installed"); }
        if kind == 8 { return @tr("Update failed: {}", detail); }
        return @tr("Press OK to check for updates");
    }
    // ui.rs `menu_label`: 0 move, 1 hide.
    public pure function menu-label(item: int) -> string {
        if item == 1 { return @tr("Hide from Home"); }
        return @tr("Move");
    }
    public pure function couldnt-open(app: string) -> string {
        return @tr("Couldn't open {}", app);
    }
    public pure function couldnt-load-apps(error: string) -> string {
        return @tr("Couldn't load apps: {}", error);
    }
    public pure function couldnt-load-notices(error: string) -> string {
        return @tr("Couldn't load the licence notices: {}", error);
    }
}

// Layout direction (set from ui.rs). For Arabic and Hebrew the layout is
// mirrored: tiles run from the right, text aligns right. Pictures and the
// (English) licence notices are not mirrored.
export global Dir {
    in property <bool> rtl;
    // `x` of a box `width` wide inside a parent `parent` wide, mirrored when rtl.
    public pure function x(x: length, width: length, parent: length) -> length {
        return rtl ? parent - x - width : x;
    }
    out property <TextHorizontalAlignment> start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
}

global Theme {
    out property <color> bg: #0E1014;
    out property <color> surface: #1C1F26;
    out property <color> text: #F2F3F5;
    out property <color> text-dim: #A4A9B4;
    out property <color> accent: #F5A524;
}

// Mode values, kept in sync with `mode_value` in ui.rs.
global Mode {
    out property <int> browse: 0;
    out property <int> moving: 1;
    out property <int> launching: 2;
    out property <int> about: 3;
    out property <int> menu: 4;
    out property <int> hidden: 5;
}

// Picture or placeholder for one app, filling its parent.
component Artwork inherits Rectangle {
    in property <TileData> data;
    in property <length> u;
    background: Theme.surface;

    // Pictures fade in: on a TV they arrive after the first frame (kind 4,
    // loading, is an empty card until then).
    Image {
        width: parent.width;
        height: parent.height;
        source: data.image;
        image-fit: cover;
        opacity: data.kind == 0 ? 1 : 0;
        animate opacity { duration: 300ms; easing: ease-out; }
    }
    Image {
        y: parent.height * 0.15;
        width: 72 * u;
        height: 72 * u;
        x: (parent.width - self.width) / 2;
        source: data.image;
        image-fit: contain;
        opacity: data.kind == 1 ? 1 : 0;
        animate opacity { duration: 300ms; easing: ease-out; }
    }
    if data.kind == 1 || data.kind == 2 || data.kind == 3 || data.kind == 5: Text {
        y: data.kind == 1 ? parent.height * 0.15 + 80 * u : 0;
        width: parent.width;
        height: data.kind == 1 ? 32 * u : parent.height;
        text: data.kind == 3 ? @tr("About RustTV") : data.kind == 5 ? @tr("Hidden apps") : data.label;
        font-size: 23 * u;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component Tile inherits Rectangle {
    in property <TileData> data;
    in property <length> u;
    in property <int> index;
    in property <bool> focused;
    in property <int> mode;
    in property <bool> pressed;
    // 0 active, 1 swaying (the focused tile, after a short idle).
    in property <int> idle-phase;
    // A dot in the corner: set on the About tile while an update is available.
    in property <bool> badge;

    property <bool> browsing: mode == Mode.browse;
    property <bool> sway: focused && browsing && !pressed && idle-phase == 1;
    property <bool> jiggle: mode == Mode.moving;
    property <bool> launching: focused && mode == Mode.launching;
    property <float> scale: launching ? 1.6
        : !focused ? 1.0
        : pressed && browsing ? 1.075
        : 1.15;
    // How much the tile sways, 0..1. Animated, so the sway grows from rest and
    // fades out again instead of jumping to wherever the phase happens to be.
    // It fades out only when the focused tile goes still after the idle time;
    // losing focus, pressing OK or launching stops it at once.
    property <float> sway-amount: sway ? 1 : 0;
    animate sway-amount {
        duration: sway || (focused && browsing && !pressed) ? 1200ms : 0ms;
        easing: ease-in-out;
    }
    // Phase in turns; evaluated only while it is used, so a still screen does not redraw.
    property <float> sway-turns: sway-amount > 0 ? animation-tick() / 4s : 0;
    property <float> jiggle-turns: jiggle ? animation-tick() / 325ms + index * 0.37 : 0;

    width: 250 * u;
    height: 141 * u;
    z: focused ? 1 : 0;

    // Focus scale is done by resizing around the centre rather than with
    // transform-scale: Slint's software renderer (desktop dev mode) ignores
    // transforms. Rotation and shadows show only with Skia (the TV).
    card := Rectangle {
        width: parent.width * scale;
        height: parent.height * scale;
        x: (parent.width - self.width) / 2 + (jiggle ? 1 * u * sin(jiggle-turns * 360deg + 90deg)
            : sway-amount * 3 * u * sin(sway-turns * 360deg + 90deg));
        y: (parent.height - self.height) / 2 + (jiggle ? 1.5 * u * sin(jiggle-turns * 720deg)
            : sway-amount * 3 * u * sin(sway-turns * 360deg));
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: jiggle ? 1.6deg * sin(jiggle-turns * 360deg)
            : sway-amount * 1.5deg * sin(sway-turns * 360deg);
        opacity: launching ? 0 : 1;
        border-radius: 12 * u;
        drop-shadow-color: focused ? #00000080 : #00000040;
        drop-shadow-blur: focused ? 40 * u : 8 * u;
        drop-shadow-offset-y: -sway-amount * 3 * u * sin(sway-turns * 360deg) + (focused ? 20 * u : 4 * u);

        animate width, height {
            duration: launching ? 500ms : focused ? 150ms : 250ms;
            easing: launching ? cubic-bezier(0.25, 0.1, 0.25, 1) : focused ? ease-out : ease-in-out;
        }
        animate opacity { duration: 500ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
        animate drop-shadow-blur, drop-shadow-color { duration: focused ? 150ms : 250ms; }

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            clip: true;

            Artwork {
                width: parent.width;
                height: parent.height;
                data: root.data;
                u: root.u;
            }

            // Sheen: a faint light band sliding across while the tile sways.
            if sway-amount > 0: Rectangle {
                width: parent.width * 0.6;
                height: parent.height;
                opacity: sway-amount;
                x: parent.width * (0.2 + 0.45 * sin(sway-turns * 360deg));
                background: @linear-gradient(90deg, #ffffff00 0%, #ffffff1f 50%, #ffffff00 100%);
            }
        }

        // The update dot. Not animated, so it adds no frames to the home screen.
        if badge: Rectangle {
            x: Dir.x(parent.width - self.width - 14 * u, self.width, parent.width);
            y: 14 * u;
            width: 18 * u;
            height: self.width;
            border-radius: self.width / 2;
            background: Theme.accent;
        }

        // Move mode: outline on the picked-up tile.
        if jiggle && focused: Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: parent.border-radius;
            border-width: 3 * u;
            border-color: Theme.accent;
        }
    }

    // Name under the focused tile only. Slint has no text shadow, so a dark copy
    // offset by (0, 2) stands in for a soft label shadow.
    label-shadow := Text {
        x: 0;
        y: parent.height + 24 * u + 2 * u;
        width: parent.width;
        text: data.kind == 3 ? @tr("About") : data.kind == 5 ? @tr("Hidden apps") : data.label;
        font-size: 25 * u;
        font-weight: 500;
        color: #00000066;
        horizontal-alignment: center;
        overflow: elide;
        opacity: focused && !launching ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    Text {
        x: 0;
        y: parent.height + 24 * u;
        width: parent.width;
        text: label-shadow.text;
        font-size: 25 * u;
        font-weight: 500;
        color: Theme.text;
        horizontal-alignment: center;
        overflow: elide;
        opacity: label-shadow.opacity;
    }
}

// The focused app's picture above the grid. Two of these cross-fade.
component HeroLayer inherits Rectangle {
    in property <TileData> data;
    in property <Glow> glow;
    in property <length> u;

    // Drawn, not an image: a full-screen backdrop bitmap per app cost up to
    // ~20 MB on a TV. The glow is a circle as wide as the screen, centred where
    // the main colour sits in the app's banner.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: glow.base;
    }
    Rectangle {
        width: parent.width * 1.3;
        height: self.width;
        x: (Dir.rtl ? 1 - glow.x : glow.x) * parent.width - self.width / 2;
        y: glow.y * parent.height - self.height / 2;
        opacity: glow.strength;
        background: @radial-gradient(circle, glow.color 0%, glow.color.with-alpha(0.45) 30%, glow.color.with-alpha(0) 70%);
    }
    // Scrim on the text side, so the backdrop can keep its colour on the right.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 780 * u;
        background: @linear-gradient(Dir.rtl ? 270deg : 90deg, #0E1014D9 0%, #0E101466 40%, #0E101400 70%);
    }
    Rectangle {
        y: 400 * u;
        height: 380 * u;
        background: @linear-gradient(180deg, #0E101400 0%, Theme.bg 100%);
    }
    Rectangle {
        y: 780 * u;
        height: parent.height - self.y;
        background: Theme.bg;
    }
    Rectangle {
        x: Dir.x(90 * u, self.width, parent.width);
        y: 360 * u;
        width: 448 * u;
        height: 252 * u;
        border-radius: 16 * u;
        clip: true;
        Artwork {
            width: parent.width;
            height: parent.height;
            data: root.data;
            u: root.u;
        }
    }
    Text {
        x: Dir.x(90 * u, self.width, parent.width);
        y: 640 * u;
        width: 1740 * u;
        horizontal-alignment: Dir.start;
        text: data.kind == 3 ? "RustTV" : data.kind == 5 ? @tr("Hidden apps") : data.label;
        font-size: 57 * u;
        font-weight: 500;
        color: Theme.text;
        overflow: elide;
    }
}

export component HomeWindow inherits Window {
    in property <[TileData]> tiles;
    in property <int> focused-index;
    in property <bool> shelf: true;
    in property <int> first-row;
    in property <int> mode;
    in property <bool> pressed;
    in property <int> idle-phase;
    in property <TileData> hero-a;
    in property <Glow> hero-a-glow;
    in property <TileData> hero-b;
    in property <Glow> hero-b-glow;
    in property <bool> hero-a-front: true;
    in property <string> toast;
    in property <string> version;
    // The updater's line on the About page (ui.rs `update_line`), and whether
    // an update waits to be installed (a dot on the About tile).
    in property <string> update-status;
    in property <bool> update-available;
    // A slice of the licence notices from the line at the top of the panel
    // (ui.rs `Notices`), how far they are scrolled (0..1) and the share shown.
    in property <string> notices;
    in property <float> notices-position;
    in property <float> notices-fraction: 1;
    // The long-press menu of the focused tile (ui.rs `menu_label`); empty when closed.
    in property <[string]> menu-items;
    in property <int> menu-selected;
    // The selected menu item's marquee (ui.rs `schedule_marquee`): its text
    // slides to its end while this is true and back while false. How long one
    // slide takes for it; 0 when it fits.
    in property <bool> menu-marquee-end;
    out property <duration> menu-marquee-time: max(0px, menu-measure.preferred-width - (380 - 16 - 48) * u) / (60 * u) * 1s;
    // The hidden apps page.
    in property <[TileData]> hidden-tiles;
    in property <int> hidden-focus;
    // Key text, pressed (false = released), repeat. Returns whether it was used.
    callback key(string, bool, bool) -> bool;

    property <length> u: self.width / 1920;

    title: "RustTV";
    forward-focus: keys;
    preferred-width: 1280px;
    preferred-height: 720px;
    background: Theme.bg;

    // Measures the selected menu item's text for `menu-marquee-time`; never drawn.
    menu-measure := Text {
        visible: false;
        text: menu-items[menu-selected];
        font-size: 27 * u;
        font-weight: 500;
    }

    keys := FocusScope {
        key-pressed(event) => {
            root.key(event.text, true, event.repeat) ? accept : reject
        }
        key-released(event) => {
            root.key(event.text, false, false) ? accept : reject
        }
    }

    Rectangle {
        opacity: shelf ? 1 : 0;
        animate opacity { duration: 250ms; }

        HeroLayer {
            data: hero-a;
            glow: hero-a-glow;
            u: root.u;
            opacity: hero-a-front ? 1 : 0;
            animate opacity { duration: 250ms; }
        }
        HeroLayer {
            data: hero-b;
            glow: hero-b-glow;
            u: root.u;
            opacity: hero-a-front ? 0 : 1;
            animate opacity { duration: 250ms; }
        }
    }

    // All rows; the whole grid moves to scroll (§3 "Two scroll states").
    Rectangle {
        y: shelf ? 800 * u : (90 - first-row * 251) * u;
        height: 0;
        animate y { duration: 250ms; easing: ease-out; }

        for tile[i] in tiles: Tile {
            x: Dir.x((90 + mod(i, 6) * 298) * u, 250 * u, root.width);
            y: floor(i / 6) * 251 * u;
            data: tile;
            u: root.u;
            index: i;
            focused: i == focused-index;
            mode: root.mode;
            pressed: root.pressed;
            idle-phase: root.idle-phase;
            badge: tile.kind == 3 && root.update-available;
        }
    }

    // Long-press menu, beside the focused tile: to its right in the first four
    // columns, else to its left. Fades in; closes at once.
    Rectangle {
        property <int> column: mod(focused-index, 6);
        property <length> tile-x: (90 + column * 298) * u;
        property <length> tile-y: shelf ? 800 * u : (90 + (floor(focused-index / 6) - first-row) * 251) * u;
        width: 380 * u;
        height: (menu-items.length * 64 + 16) * u;
        // 19 is how far the focused tile grows past its slot on each side.
        x: Dir.x(column < 4 ? self.tile-x + (250 + 19 + 24) * u : self.tile-x - (19 + 24) * u - self.width, self.width, root.width);
        y: self.tile-y + (141 * u - self.height) / 2;
        opacity: mode == Mode.menu ? 1 : 0;
        animate opacity { duration: mode == Mode.menu ? 150ms : 0ms; easing: ease-out; }
        border-radius: 16 * u;
        background: Theme.surface;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 40 * u;
        drop-shadow-offset-y: 20 * u;

        for item[i] in menu-items: Rectangle {
            x: 8 * u;
            y: (8 + i * 64) * u;
            width: parent.width - 16 * u;
            height: 64 * u;
            border-radius: 10 * u;
            background: i == menu-selected ? Theme.text : Theme.text.with-alpha(0);
            animate background { duration: 120ms; }
            // A text too long for the menu (some translations) is cut with
            // "…". While its item is selected it slides to its end and back,
            // paced by ui.rs (`menu-marquee-end`), so a menu that fits adds
            // no frames.
            Rectangle {
                x: 24 * u;
                width: parent.width - 48 * u;
                clip: true;
                property <length> overflow: max(0px, label.preferred-width - self.width);
                property <bool> sliding: i == menu-selected && mode == Mode.menu && self.overflow > 0;
                property <length> shift: self.sliding && menu-marquee-end ? self.overflow : 0px;
                animate shift { duration: self.overflow / (60 * u) * 1s; easing: ease-in-out; }
                label := Text {
                    // Reads `shift` in every case: Slint evaluates lazily, and a
                    // value first read while it changes jumps instead of
                    // animating. Right-to-left starts at the right end.
                    x: Dir.rtl ? parent.shift - (parent.sliding ? parent.overflow : 0px) : -parent.shift;
                    width: parent.sliding ? self.preferred-width : parent.width;
                    text: item;
                    horizontal-alignment: Dir.start;
                    font-size: 27 * u;
                    font-weight: 500;
                    color: i == menu-selected ? Theme.bg : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                    animate color { duration: 120ms; }
                }
                // Soft edges instead of a hard cut: where the text goes on
                // past an edge, that edge fades into the item's colour.
                // Kept off the item's top and bottom: covering its anti-aliased
                // edge there would draw a sharper, higher edge (the text never
                // reaches that far).
                property <length> fade: 32 * u;
                if self.sliding: Rectangle {
                    // The end, while more text is to come.
                    y: 8 * u;
                    height: parent.height - 16 * u;
                    x: Dir.x(parent.width - parent.fade, parent.fade, parent.width);
                    width: parent.fade;
                    opacity: min(1, (parent.overflow - parent.shift) / parent.fade);
                    background: @linear-gradient(Dir.rtl ? 270deg : 90deg, Theme.text.with-alpha(0) 0%, Theme.text 100%);
                }
                if self.sliding: Rectangle {
                    // The start, once the text has slid.
                    y: 8 * u;
                    height: parent.height - 16 * u;
                    x: Dir.x(0px, parent.fade, parent.width);
                    width: parent.fade;
                    opacity: min(1, parent.shift / parent.fade);
                    background: @linear-gradient(Dir.rtl ? 90deg : 270deg, Theme.text.with-alpha(0) 0%, Theme.text 100%);
                }
            }
        }
    }

    // Hidden apps: the same tiles on their own page; the grid scrolls by
    // whole rows to keep the focused row among the first three.
    if mode == Mode.hidden: Rectangle {
        background: Theme.bg;

        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 90 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("Hidden apps");
            font-size: 57 * u;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            x: Dir.x(90 * u, self.width, parent.width);
            y: 176 * u;
            width: 1740 * u;
            horizontal-alignment: Dir.start;
            text: @tr("OK puts the app back on Home. Back returns.");
            font-size: 25 * u;
            color: Theme.text-dim;
        }
        Rectangle {
            y: 260 * u;
            height: parent.height - self.y;
            clip: true;

            Rectangle {
                y: (80 - max(0, floor(hidden-focus / 6) - 2) * 251) * u;
                height: 0;
                animate y { duration: 250ms; easing: ease-out; }

                for tile[i] in hidden-tiles: Tile {
                    x: Dir.x((90 + mod(i, 6) * 298) * u, 250 * u, root.width);
                    y: floor(i / 6) * 251 * u;
                    data: tile;
                    u: root.u;
                    index: i;
                    focused: i == hidden-focus;
                    mode: Mode.browse;
                    pressed: false;
                    idle-phase: root.idle-phase;
                }
            }
        }
    }

    if toast != "": Rectangle {
        x: Dir.x(90 * u, self.width, root.width);
        y: (1020 - 64) * u;
        width: toast-text.preferred-width + 48 * u;
        height: 64 * u;
        border-radius: 12 * u;
        background: Theme.surface;
        toast-text := Text {
            x: 24 * u;
            text: toast;
            font-size: 29 * u;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    // About: who made RustTV on the left, the licence notices on the right
    // (swapped for right-to-left languages).
    if mode == Mode.about: Rectangle {
        background: Theme.bg;

        VerticalLayout {
            x: Dir.x(90 * u, self.width, parent.width);
            width: 560 * u;
            padding-top: 120 * u;
            padding-bottom: 90 * u;
            spacing: 24 * u;
            alignment: start;
            Text {
                horizontal-alignment: Dir.start;
                text: "RustTV";
                font-size: 76 * u;
                font-weight: 500;
                color: Theme.text;
            }
            Text {
                horizontal-alignment: Dir.start;
                text: @tr("Version {} · MIT OR Apache-2.0", version);
                font-size: 29 * u;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            Text {
                horizontal-alignment: Dir.start;
                text: update-status;
                font-size: 29 * u;
                color: update-available ? Theme.accent : Theme.text;
                wrap: word-wrap;
            }
            Text {
                horizontal-alignment: Dir.start;
                text: @tr("Built with Slint under the Slint Royalty-free License 2.0. Also includes Skia (BSD-3-Clause) and Rust libraries under MIT or Apache-2.0.");
                font-size: 25 * u;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            Text {
                horizontal-alignment: Dir.start;
                text: @tr("Source: github.com/damienmiheev/rusttv");
                font-size: 25 * u;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            AboutSlint {
                height: 240 * u;
            }
            Text {
                horizontal-alignment: Dir.start;
                text: @tr("Up and Down scroll the notices. Back returns.");
                font-size: 25 * u;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }

        panel := Rectangle {
            x: Dir.x(720 * u, self.width, parent.width);
            y: 90 * u;
            width: 1110 * u;
            height: 900 * u;
            border-radius: 16 * u;
            background: Theme.surface;
            clip: true;

            Text {
                x: Dir.x(48 * u, self.width, parent.width);
                y: 36 * u;
                width: parent.width - 96 * u;
                horizontal-alignment: Dir.start;
                text: @tr("Third-party notices");
                font-size: 29 * u;
                font-weight: 500;
                color: Theme.text;
            }
            body := Rectangle {
                x: 48 * u;
                y: 96 * u;
                width: parent.width - 120 * u;
                height: parent.height - self.y - 36 * u;
                clip: true;
                Text {
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: notices;
                    font-size: 22 * u;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
                // Soft edges, so cut-off lines fade instead of ending sharply.
                Rectangle {
                    y: 0;
                    height: 24 * u;
                    opacity: notices-position > 0 ? 1 : 0;
                    background: @linear-gradient(180deg, Theme.surface 0%, #1C1F2600 100%);
                }
                Rectangle {
                    y: parent.height - self.height;
                    height: 72 * u;
                    background: @linear-gradient(180deg, #1C1F2600 0%, Theme.surface 100%);
                }
            }
            // Scroll bar: where the panel is in all the notices.
            if notices-fraction < 1: Rectangle {
                x: Dir.x(parent.width - 36 * u, self.width, parent.width);
                y: body.y;
                width: 4 * u;
                height: body.height;
                border-radius: self.width / 2;
                background: #FFFFFF14;
                Rectangle {
                    property <length> thumb: max(parent.height * notices-fraction, 48 * u);
                    y: (parent.height - self.thumb) * notices-position;
                    height: self.thumb;
                    border-radius: parent.border-radius;
                    background: #FFFFFF66;
                    animate y { duration: 120ms; easing: ease-out; }
                }
            }
        }
    }
}
