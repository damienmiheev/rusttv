// Page blocks (PANELS.md § 4): one component per block of a panel's page,
// placed by the pages build.rs generates from panel templates. Sizes live
// here and colours in `Theme`, so a later theme changes every page at once.
// Focus and keys are Home's (ui.rs): blocks only draw.

import { AboutSlint } from "std-widgets.slint";
import { Dir, Hints, Theme } from "theme.slint";
import { SettingsRow } from "quick.slint";

// A `rows` block's rows: Settings' row data.
export { SettingsRow }

export enum TitleSize {
    // A page of its own (About).
    large,
    // A list page's title (`PageHeader`), or a heading on a page of its own.
    medium,
    // A heading inside the surface panel.
    small,
}

export enum TextSize {
    normal,
    small,
}

export enum Tone {
    normal,
    dim,
    // Asks for attention (e.g. an update waits to be installed).
    accent,
}

// The page's start column: 560 u beside the surface panel (two columns), or
// the whole width (one column). Under a header (a list page: Settings,
// RustTV Remote) it starts at 260 u, beside the panel it is 480 u wide, and
// its blocks are 36 u apart. Fills the page; mirrored in right-to-left.
export component PageColumn inherits Rectangle {
    in property <length> u;
    in property <bool> wide;
    in property <bool> header;
    // A block (rows) fills the column's height left under the others.
    in property <bool> fills;
    VerticalLayout {
        x: Dir.x(90 * u, self.width, root.width);
        width: (wide ? 1740 : header ? 480 : 560) * u;
        padding-top: (header ? 260 : 120) * u;
        padding-bottom: 90 * u;
        spacing: (header ? 36 : 24) * u;
        // Blocks keep their own height at the top; with rows, the rows
        // (the one block that stretches) take the rest.
        alignment: fills ? LayoutAlignment.stretch : LayoutAlignment.start;
        @children
    }
}

// The surface panel at the end side of a two-column page, from 90 u to
// 990 u, or from 260 u to 1020 u under a header. Fills the page.
export component PageSurface inherits Rectangle {
    in property <length> u;
    in property <bool> header;
    // A block (a scroll box, rows) fills the panel's height.
    in property <bool> fills;
    Rectangle {
        x: Dir.x(720 * u, self.width, root.width);
        y: (header ? 260 : 90) * u;
        width: 1110 * u;
        height: (header ? 760 : 900) * u;
        border-radius: Theme.panel-radius * u;
        background: Theme.surface.with-alpha(Theme.panel-opacity);
        border-width: Theme.panel-border-width * u;
        border-color: Theme.panel-border-color;
        clip: true;
        VerticalLayout {
            padding-top: 36 * u;
            padding-bottom: 36 * u;
            padding-left: 48 * u;
            padding-right: 48 * u;
            spacing: 24 * u;
            @children
            // Takes the height no block wants (a scroll box takes it
            // instead), so text blocks keep their own height at the top.
            if !fills: Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}

export component PageTitle inherits Text {
    in property <length> u;
    in property <TitleSize> size;
    horizontal-alignment: Dir.start;
    font-size: (size == TitleSize.large ? 76 : size == TitleSize.medium ? 57 : 29) * u;
    font-weight: 500;
    color: Theme.text;
    overflow: elide;
    vertical-alignment: top;
    // A heading in the surface panel has a fixed 36 u line box whatever the
    // font or script, so the block under it starts where it always did.
    min-height: size == TitleSize.small ? 36 * u : 0;
    max-height: size == TitleSize.small ? 36 * u : 1000 * u;
    vertical-stretch: 0;
}

// A list page's header, above both columns: its title (a medium
// `PageTitle`), and under it Home's status line (`status`: what just
// happened, e.g. a phone removed) or, without one, the dim key hint (empty
// without key hints). One line, elided.
export component PageHeader inherits Rectangle {
    in property <length> u;
    in property <string> title;
    in property <string> hint;
    in property <string> status;
    PageTitle {
        x: Dir.x(90 * u, self.width, parent.width);
        y: 90 * u;
        width: 1740 * u;
        u: root.u;
        size: TitleSize.medium;
        text: root.title;
    }
    Text {
        x: Dir.x(90 * u, self.width, parent.width);
        y: 176 * u;
        width: 1740 * u;
        horizontal-alignment: Dir.start;
        text: root.status != "" ? root.status : Hints.keys ? root.hint : "";
        font-size: 25 * u;
        color: root.status != "" ? Theme.text : Theme.text-dim;
        overflow: elide;
    }
}

// One paragraph; wraps. A state line (the updater's) is a normal-size text
// whose tone turns to the accent when it asks for attention.
export component PageText inherits Text {
    in property <length> u;
    in property <TextSize> size;
    in property <Tone> tone;
    horizontal-alignment: Dir.start;
    font-size: (size == TextSize.small ? 25 : 29) * u;
    color: tone == Tone.accent ? Theme.accent : tone == Tone.dim ? Theme.text-dim : Theme.text;
    wrap: word-wrap;
}

// Which keys move around; empty for a pointer-driven home screen.
export component PageHint inherits Text {
    in property <length> u;
    in property <string> value;
    horizontal-alignment: Dir.start;
    text: Hints.keys ? value : "";
    font-size: 25 * u;
    color: Theme.text-dim;
    wrap: word-wrap;
}

// Slint's attribution (its Royalty-free License asks for it), at a size
// a template can't change.
export component PageSlintBadge inherits Rectangle {
    in property <length> u;
    height: 240 * u;
    AboutSlint {
        width: parent.width;
        height: parent.height;
    }
}

// A picture Home provides (the `Pictures` global, e.g. RustTV Remote's
// banner): the column's width, 270 u tall (16:9 in a list page's 480 u
// column), rounded, cropped to fill.
export component PagePicture inherits Rectangle {
    in property <length> u;
    in property <image> source;
    height: 270 * u;
    border-radius: 16 * u;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
}

// Long text that Home scrolls with Up and Down (ui.rs `Notices`): `text` is
// the slice from the line at the top, `position` how far it is scrolled
// (0..1), `fraction` the share shown. Fills the surface panel's height; the
// scroll bar sits in the panel's end padding. The text is not mirrored (the
// licence notices are English).
export component PageScrollBox inherits Rectangle {
    in property <length> u;
    in property <string> text;
    in property <float> position;
    in property <float> fraction: 1;
    vertical-stretch: 1;

    Rectangle {
        // Mirrored, so the scroll bar keeps its gap in right-to-left.
        x: Dir.x(0, self.width, parent.width);
        y: 0;
        width: parent.width - 24 * u;
        height: parent.height;
        clip: true;
        Text {
            y: 0;
            width: parent.width;
            height: parent.height;
            text: root.text;
            font-size: 22 * u;
            color: Theme.text-dim;
            wrap: word-wrap;
            vertical-alignment: top;
        }
        // Soft edges, so cut-off lines fade instead of ending sharply.
        Rectangle {
            y: 0;
            height: 24 * u;
            opacity: root.position > 0 ? 1 : 0;
            background: @linear-gradient(180deg, Theme.surface 0%, Theme.surface.with-alpha(0) 100%);
        }
        Rectangle {
            y: parent.height - self.height;
            height: 72 * u;
            background: @linear-gradient(180deg, Theme.surface.with-alpha(0) 0%, Theme.surface 100%);
        }
    }
    // Scroll bar: where the box is in all the text.
    if root.fraction < 1: Rectangle {
        x: Dir.x(parent.width + 12 * u, self.width, parent.width);
        y: 0;
        width: 4 * u;
        height: parent.height;
        border-radius: self.width / 2;
        background: #FFFFFF14;
        Rectangle {
            property <length> thumb: max(parent.height * root.fraction, 48 * u);
            y: (parent.height - self.thumb) * root.position;
            height: self.thumb;
            border-radius: parent.border-radius;
            background: #FFFFFF66;
            animate y { duration: 120ms; easing: ease-out; }
        }
    }
}

// A row in the long-press menu's style: a light pill with dark text when
// selected, the update dot's accent dot for the current choice.
export component MenuRow inherits Rectangle {
    in property <length> u;
    in property <string> text;
    in property <string> detail;
    in property <bool> selected;
    // Selected while focus is elsewhere (the section whose panel is open).
    in property <bool> marked;
    in property <bool> current;
    in property <bool> dim;
    // Two lines tall even without a detail (`SettingsRow.tall`).
    in property <bool> tall;
    property <bool> two-lines: detail != "" || tall;
    height: (two-lines ? 96 : 64) * u;
    border-radius: min(Theme.tile-radius, 12.0) * u;
    background: !selected
        ? (marked ? Theme.surface.with-alpha(Theme.panel-opacity) : Theme.text.with-alpha(0))
        : Theme.selection-style == 1 ? Theme.accent
        : Theme.selection-style == 2 ? Theme.surface.with-alpha(0.95)
        : Theme.text;
    animate background { duration: 120ms * Theme.motion-scale; }
    if selected && Theme.selection-style == 2: Rectangle {
        x: Dir.x(6 * u, self.width, parent.width);
        y: 12 * u;
        width: 6 * u;
        height: parent.height - 24 * u;
        border-radius: 3 * u;
        background: Theme.accent;
    }
    if current: Rectangle {
        x: Dir.x(18 * u, self.width, parent.width);
        y: (two-lines ? 28 * u : (parent.height - self.height) / 2);
        width: 10 * u;
        height: 10 * u;
        border-radius: self.width / 2;
        background: selected && Theme.selection-style == 1 ? Theme.accent-text : Theme.accent;
    }
    Text {
        x: Dir.x(44 * u, self.width, parent.width);
        y: two-lines ? 12 * u : 0;
        width: parent.width - 68 * u;
        height: two-lines ? 34 * u : parent.height;
        text: root.text;
        font-size: 27 * u;
        font-weight: selected ? 600 : 500;
        color: !selected ? (dim ? Theme.text-dim : Theme.text)
            : Theme.selection-style == 1 ? Theme.accent-text
            : Theme.selection-style == 2 ? Theme.text
            : Theme.bg;
        horizontal-alignment: Dir.start;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms * Theme.motion-scale; }
    }
    if detail != "": Text {
        x: Dir.x(44 * u, self.width, parent.width);
        y: 50 * u;
        width: parent.width - 68 * u;
        height: 32 * u;
        text: root.detail;
        font-size: 25 * u;
        color: !selected ? Theme.text-dim
            : Theme.selection-style == 1 ? Theme.accent-text.with-alpha(0.75)
            : Theme.selection-style == 2 ? Theme.text-dim
            : Theme.bg.with-alpha(0.7);
        horizontal-alignment: Dir.start;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms * Theme.motion-scale; }
    }
}

// A focusable list Home fills (`model`, Settings' row data): `focused` is the
// focused row and `first` the first one shown, as Home scrolls by rows. Up
// and Down are Home's; the pointer reports a row it moves over (0) or
// clicks (1), and Home walks the focus there behind its `pointer_reaches`
// guard (ui.rs). Fills the height the column or panel leaves it (`fills`).
// Rows are 104 u apart, room for a detail line. In the surface panel
// (`outset`) the rows reach into the panel's padding, 24 u from its edges,
// as Settings' rows do, so a focused row's pill frames the panel's text;
// the outset is the same on both sides, so it needs no `Dir`.
export component PageRows inherits Rectangle {
    in property <length> u;
    in property <[SettingsRow]> model;
    in property <int> focused;
    in property <int> first;
    in property <bool> outset;
    callback pointer(/* index */ int, /* action */ int);
    vertical-stretch: 1;

    Rectangle {
        x: (root.outset ? -48 : 0) * u;
        y: (root.outset ? -12 : 0) * u;
        width: parent.width + (root.outset ? 96 : 0) * u;
        height: parent.height + (root.outset ? 24 : 0) * u;
        clip: true;
        for row[i] in root.model: MenuRow {
            x: (root.outset ? 24 : 0) * u;
            y: (i - root.first) * 104 * u;
            width: parent.width - (root.outset ? 48 : 0) * u;
            u: root.u;
            text: row.title;
            detail: row.detail;
            tall: row.tall;
            current: row.current;
            dim: row.dim;
            selected: i == root.focused;
            visible: i >= root.first;
        }
        for row[i] in root.model: TouchArea {
            x: (root.outset ? 24 : 0) * u;
            y: (i - root.first) * 104 * u;
            width: parent.width - (root.outset ? 48 : 0) * u;
            height: 96 * u;
            visible: i >= root.first;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.pointer(i, 0);
                }
            }
            clicked => {
                root.pointer(i, 1);
            }
        }
    }
}
