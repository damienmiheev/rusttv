// The top-right menu over Home, the quick panels it opens, the volume bar,
// and the rows of platform controls (src/device.rs) shared with Settings.
// Rust owns all state (src/ui/device_view.rs); this file only draws it.
// Sizes are reference pixels on a 1920×1080 canvas, multiplied by `u`.

import { Theme } from "theme.slint";

// One row of a Settings panel or quick panel (ui.rs `settings_rows`,
// ui/device_view.rs).
export struct SettingsRow {
    title: string,
    // A second, dim line; empty for one-line rows.
    detail: string,
    // The current choice: an accent dot.
    current: bool,
    // Shown dim (e.g. animations without the grant).
    dim: bool,
    // A slider: a level bar after the detail, filled to `level` (0..1).
    slider: bool,
    level: float,
    // Two lines tall even while `detail` is empty, so a detail that comes
    // later (History's age) doesn't move the rows under it (a list's
    // `MenuRow`).
    tall: bool,
}

// A row in the long-press menu's style (home.slint `MenuRow`), with a level
// bar for sliders. Left and right are mirrored when `rtl`.
export component ControlRow inherits Rectangle {
    in property <length> u;
    in property <bool> rtl;
    in property <string> text;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> current;
    in property <bool> dim;
    in property <bool> slider;
    in property <float> level;
    // Two lines tall even while `detail` is empty (`SettingsRow.tall`).
    in property <bool> tall;
    property <bool> one-line: detail == "" && !slider && !tall;
    height: (one-line ? 64 : 96) * u;
    border-radius: min(Theme.tile-radius, 12.0) * u;
    background: !selected ? Theme.text.with-alpha(0)
        : Theme.selection-style == 1 ? Theme.accent
        : Theme.selection-style == 2 ? Theme.text.with-alpha(0.12)
        : Theme.text;
    animate background { duration: 120ms * Theme.motion-scale; }

    pure function place-x(x: length, width: length) -> length {
        return rtl ? self.width - x - width : x;
    }
    property <TextHorizontalAlignment> start: rtl ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    property <color> sel-fg: Theme.selection-style == 1 ? Theme.accent-text
        : Theme.selection-style == 2 ? Theme.text
        : Theme.bg;

    if selected && Theme.selection-style == 2: Rectangle {
        x: root.place-x(6 * u, 6 * u);
        y: 12 * u;
        width: 6 * u;
        height: parent.height - 24 * u;
        border-radius: 3 * u;
        background: Theme.accent;
    }
    if current: Rectangle {
        x: root.place-x(18 * u, 10 * u);
        y: (root.one-line ? (parent.height - self.height) / 2 : 28 * u);
        width: 10 * u;
        height: 10 * u;
        border-radius: self.width / 2;
        background: selected && Theme.selection-style == 1 ? Theme.accent-text : Theme.accent;
    }
    Text {
        x: root.place-x(44 * u, self.width);
        y: root.one-line ? 0 : 12 * u;
        width: parent.width - 68 * u;
        height: root.one-line ? parent.height : 34 * u;
        text: root.text;
        font-size: 27 * u;
        font-weight: selected ? 600 : 500;
        color: selected ? root.sel-fg : dim ? Theme.text-dim : Theme.text;
        horizontal-alignment: root.start;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms * Theme.motion-scale; }
    }
    if detail != "" || slider: Text {
        x: root.place-x(44 * u, self.width);
        y: 50 * u;
        width: slider ? 110 * u : parent.width - 68 * u;
        height: 32 * u;
        text: root.detail;
        font-size: 25 * u;
        color: selected ? root.sel-fg.with-alpha(0.75) : Theme.text-dim;
        horizontal-alignment: root.start;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms * Theme.motion-scale; }
    }
    if slider: Rectangle {
        x: root.place-x(170 * u, self.width);
        y: 62 * u;
        width: parent.width - 214 * u;
        height: 8 * u;
        border-radius: self.height / 2;
        background: selected ? root.sel-fg.with-alpha(0.22) : #FFFFFF26;
        Rectangle {
            x: rtl ? parent.width - self.width : 0;
            width: parent.width * clamp(level, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: selected ? (Theme.selection-style == 2 ? Theme.accent : root.sel-fg) : Theme.accent;
        }
    }
}

// The top-right menu (like Plasma Bigscreen's): round icon buttons, the
// focused one a light disc like a selected menu row, with its name below.
// `actions` are model.rs `QuickAction` codes (ui/device_view.rs
// `quick_code`): 0 Search, 1 Modify, 2 Audio, 3 Network, 4 KDE Connect,
// 5 Settings, 6 Power, 7 RustTV (the panels' rows, PANELS.md § 2). Its
// top-right corner sits at its parent's.
export component QuickBar inherits Rectangle {
    in property <length> u;
    in property <bool> rtl;
    in property <[int]> actions;
    // -1 while focus is on the tiles.
    in property <int> selected: -1;
    // The network interfaces, shown in the Network entry (code 3), one icon
    // each: 100 + bars (0 not connected, 1..4) for Wi-Fi, 200 / 201 for a
    // cable unplugged / connected (ui/device_view.rs `link_code`). Entries
    // before Network have a lower code and those after it a higher one
    // (model.rs `QuickAction::ALL`).
    in property <[int]> links;
    // Softens unfocused buttons when `top_bar_style = "minimal"` without
    // setting container `opacity < 1.0` (which allocates a Skia FBO layer).
    in property <bool> dimmed: false;
    // A click on entry `index`.
    callback clicked(int);
    // The pointer moved onto entry `index`.
    callback hovered(int);

    property <bool> labeled-bar: Theme.top-bar-style == 3 || Theme.top-bar-style == 5;
    property <bool> bare-icons: Theme.top-bar-style == 4;
    property <bool> google-tv-bar: Theme.top-bar-style == 6;
    property <length> size: bare-icons || google-tv-bar ? 56 * u : 72 * u;
    property <length> gap: bare-icons || google-tv-bar ? 14 * u : 18 * u;
    property <length> link-width: bare-icons || google-tv-bar ? 36 * u : 44 * u;
    // How much wider the Network entry is than a round one.
    property <length> net-extra: max(0px, links.length * link-width + 28 * u - size);
    property <length> brand-w: google-tv-bar ? 116 * u : 0px;
    property <length> icon-bar-width: max(0px, actions.length * (size + gap) - gap + net-extra) + brand-w;

    // Left edge of entry `i` (code `code`) in left-to-right order, and its width.
    pure function start(i: int, code: int) -> length {
        return i * (size + gap) + (code > 3 ? net-extra : 0px);
    }
    pure function span(code: int) -> length {
        return code == 3 ? size + net-extra : size;
    }
    // Wi-Fi with `bars` arcs (1..4), drawn over a dim full icon.
    pure function wifi(bars: int) -> string {
        if bars >= 4 { return "M 2 9 A 14 14 0 0 1 22 9 M 5.5 12.5 A 9 9 0 0 1 18.5 12.5 M 9 16 A 4.5 4.5 0 0 1 15 16 M 12 19 L 12 19.5"; }
        if bars == 3 { return "M 5.5 12.5 A 9 9 0 0 1 18.5 12.5 M 9 16 A 4.5 4.5 0 0 1 15 16 M 12 19 L 12 19.5"; }
        if bars == 2 { return "M 9 16 A 4.5 4.5 0 0 1 15 16 M 12 19 L 12 19.5"; }
        return "M 12 19 L 12 19.5";
    }
    // An Ethernet socket.
    property <string> wired: "M 4 7 L 20 7 L 20 19 L 4 19 Z M 8 19 L 8 15 M 12 19 L 12 15 M 16 19 L 16 15 M 9 7 L 9 4 L 15 4 L 15 7";

    pure function name(code: int) -> string {
        if code == 0 { return @tr("Search"); }
        if code == 1 { return @tr("Modify"); }
        if code == 2 { return @tr("Audio"); }
        if code == 3 { return @tr("Network"); }
        if code == 4 { return @tr("KDE Connect"); }
        if code == 5 { return @tr("Settings"); }
        // A name, the same in every language.
        if code == 7 { return "RustTV"; }
        return @tr("Power");
    }
    // 24 × 24 outline icons, drawn as strokes.
    pure function icon(code: int) -> string {
        if code == 0 { return "M 10 3 A 7 7 0 1 0 10 17 A 7 7 0 1 0 10 3 Z M 15 15 L 21 21"; }
        if code == 1 { return "M 4 20 L 4 16 L 15 5 L 19 9 L 8 20 Z M 13 7 L 17 11"; }
        if code == 2 { return "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 15.5 9 A 4 4 0 0 1 15.5 15 M 18 6 A 8 8 0 0 1 18 18"; }
        if code == 3 { return "M 2 9 A 14 14 0 0 1 22 9 M 5.5 12.5 A 9 9 0 0 1 18.5 12.5 M 9 16 A 4.5 4.5 0 0 1 15 16 M 12 19 L 12 19.5"; }
        if code == 4 { return "M 7 2 L 17 2 L 17 22 L 7 22 Z M 10.5 18.5 L 13.5 18.5"; }
        // Four tiles: RustTV's own panels.
        if code == 7 { return "M 4 4 L 10 4 L 10 10 L 4 10 Z M 14 4 L 20 4 L 20 10 L 14 10 Z M 4 14 L 10 14 L 10 20 L 4 20 Z M 14 14 L 20 14 L 20 20 L 14 20 Z"; }
        if code == 5 { return "M 19.18 9.51 L 21.77 9.86 L 21.77 14.14 L 19.18 14.49 L 18.84 15.32 L 20.42 17.39 L 17.39 20.42 L 15.32 18.84 L 14.49 19.18 L 14.14 21.77 L 9.86 21.77 L 9.51 19.18 L 8.68 18.84 L 6.61 20.42 L 3.58 17.39 L 5.16 15.32 L 4.82 14.49 L 2.23 14.14 L 2.23 9.86 L 4.82 9.51 L 5.16 8.68 L 3.58 6.61 L 6.61 3.58 L 8.68 5.16 L 9.51 4.82 L 9.86 2.23 L 14.14 2.23 L 14.49 4.82 L 15.32 5.16 L 17.39 3.58 L 20.42 6.61 L 18.84 8.68 Z M 15.2 12 A 3.2 3.2 0 1 0 8.8 12 A 3.2 3.2 0 1 0 15.2 12 Z"; }
        return "M 12 2.5 L 12 11 M 6.5 5.5 A 8 8 0 1 0 17.5 5.5";
    }

    width: labeled-bar ? labeled-row.preferred-width : icon-bar-width;
    height: labeled-bar ? (Theme.top-bar-style == 5 ? 46 : 52) * u : size;

    // Inline-labels (`top_bar_style = "inline-labels"`, Projectivy Glass) and
    // stadium glass pills (`top_bar_style = "glass-pills"`, Ambient Pills).
    labeled-row := HorizontalLayout {
        visible: root.labeled-bar;
        spacing: (Theme.top-bar-style == 5 ? 10 : 28) * u;
        for code[i] in actions: pill := Rectangle {
            property <bool> focused: i == selected;
            property <bool> is-glass-pill: Theme.top-bar-style == 5;
            property <color> ink: focused && is-glass-pill ? Theme.bg : Theme.text;
            height: (is-glass-pill ? 46 : 52) * u;
            width: inner.preferred-width;
            border-radius: self.height / 2;
            background: is-glass-pill
                ? (focused ? Theme.text : #FFFFFF18)
                : (focused ? #FFFFFF2E : transparent);
            border-width: is-glass-pill ? 1.5 * u : (focused ? 1.5 * u : 0px);
            border-color: is-glass-pill
                ? (focused ? Theme.text : #FFFFFF48)
                : #FFFFFF66;
            animate background { duration: 120ms * Theme.motion-scale; }

            inner := HorizontalLayout {
                padding-left: (pill.is-glass-pill ? 18 : 12) * u;
                padding-right: (pill.is-glass-pill ? 20 : 12) * u;
                height: parent.height;
                spacing: (pill.is-glass-pill ? 8 : 10) * u;
                alignment: center;
                Rectangle {
                    width: (pill.is-glass-pill ? 20 : 24) * u;
                    height: parent.height;
                    Path {
                        x: 0;
                        y: (parent.height - parent.width) / 2;
                        width: parent.width;
                        height: parent.width;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.icon(code);
                        stroke: pill.ink;
                        stroke-width: 2.2 * u;
                        fill: transparent;
                    }
                }
                Text {
                    text: root.name(code);
                    font-size: (pill.is-glass-pill ? 18 : 22) * u;
                    font-weight: pill.focused ? 600 : 400;
                    color: pill.ink;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.hovered(i);
                    }
                }
                clicked => { root.clicked(i); }
            }
        }
    }

    // Round icon buttons (floating, strip, minimal, bare-icons, google-tv).
    if !root.labeled-bar: Rectangle {
        width: parent.width;
        height: parent.height;
        for code[i] in actions: button := Rectangle {
            property <bool> focused: i == selected;
            property <color> ink: focused ? Theme.bg : (root.dimmed ? Theme.text.with-alpha(0.58) : Theme.text);
            width: root.span(code);
            x: rtl ? root.width - root.start(i, code) - self.width - root.brand-w : root.start(i, code);
            height: size;
            border-radius: self.height / 2;
            background: focused ? Theme.text
                : root.bare-icons ? transparent
                : root.google-tv-bar ? #FFFFFF1E
                : (root.dimmed ? #00000038 : #0000005C);
            animate background { duration: 120ms * Theme.motion-scale; }
            if code != 3 || links.length == 0: Path {
                x: (parent.width - parent.height * 0.5) / 2;
                y: parent.height * 0.25;
                width: parent.height * 0.5;
                height: parent.height * 0.5;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon(code);
                stroke: parent.ink;
                stroke-width: (root.bare-icons || root.google-tv-bar ? 2.2 : 2.6) * u;
                fill: transparent;
            }
            // Network: one icon per interface; the dim full icon under a Wi-Fi's
            // bars, a dim socket for an unplugged cable.
            if code == 3: Rectangle {
                x: 14 * u;
                width: parent.width - 28 * u;
                for link[j] in links: Rectangle {
                    property <bool> is-wifi: link < 200;
                    property <bool> up: is-wifi ? link > 100 : link == 201;
                    x: rtl ? parent.width - (j + 1) * root.link-width : j * root.link-width;
                    width: root.link-width;
                    Path {
                        x: (parent.width - 32 * u) / 2;
                        y: (root.size - 32 * u) / 2;
                        width: 32 * u;
                        height: 32 * u;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: parent.is-wifi ? root.wifi(4) : root.wired;
                        stroke: button.ink;
                        stroke-width: 2.4 * u;
                        fill: transparent;
                        opacity: parent.up && !parent.is-wifi ? 1 : 0.35;
                    }
                    if is-wifi && up: Path {
                        x: (parent.width - 32 * u) / 2;
                        y: (root.size - 32 * u) / 2;
                        width: 32 * u;
                        height: 32 * u;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.wifi(link - 100);
                        stroke: button.ink;
                        stroke-width: 2.4 * u;
                        fill: transparent;
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.hovered(i);
                    }
                }
                clicked => { root.clicked(i); }
            }
        }
        // Google TV trailing wordmark ("RustTV") next to the circular buttons.
        if root.google-tv-bar: Text {
            x: rtl ? 0px : parent.width - root.brand-w + 20 * u;
            width: root.brand-w - 20 * u;
            height: parent.height;
            text: "RustTV";
            font-size: 24 * u;
            font-weight: 500;
            color: Theme.text.with-alpha(0.72);
            vertical-alignment: center;
            horizontal-alignment: rtl ? left : right;
        }
    }
    if !root.labeled-bar && selected >= 0: Text {
        property <length> centre: (rtl ? root.width - root.start(selected, actions[selected]) - root.span(actions[selected]) - root.brand-w : root.start(selected, actions[selected])) + root.span(actions[selected]) / 2;
        x: rtl ? max(self.centre - 160 * u, -60 * u) : min(self.centre - 160 * u, root.width + 60 * u - 320 * u);
        y: size + 14 * u;
        width: 320 * u;
        horizontal-alignment: center;
        text: root.name(actions[selected]);
        font-size: 25 * u;
        font-weight: 500;
        color: Theme.text;
        overflow: elide;
    }
}

// A quick panel under the top-right menu: its title, a status line while
// reading or after a failure, and its controls. Rows past the panel scroll
// by rows (`first-row`).
export component QuickPanel inherits Rectangle {
    in property <length> u;
    in property <bool> rtl;
    in property <string> title;
    in property <string> status;
    in property <[SettingsRow]> rows;
    in property <int> focused-row;
    in property <int> first-row;
    callback row-clicked(int);
    // The pointer moved onto row `index`.
    callback row-hovered(int);

    property <length> pitch: 104 * u;
    property <int> shown: min(6, max(1, rows.length - first-row));
    property <length> list-y: (status == "" ? 96 : 140) * u;

    width: 720 * u;
    height: self.list-y + self.shown * self.pitch + 16 * u;
    border-radius: Theme.panel-radius * u;
    background: Theme.surface.with-alpha(Theme.panel-opacity);
    border-width: Theme.panel-border-width * u;
    border-color: Theme.panel-border-color;
    drop-shadow-color: #00000080;
    drop-shadow-blur: 40 * u;
    drop-shadow-offset-y: 16 * u;
    clip: true;

    Text {
        x: 40 * u;
        y: 32 * u;
        width: parent.width - 80 * u;
        horizontal-alignment: rtl ? right : left;
        text: title;
        font-size: 33 * u;
        font-weight: 500;
        color: Theme.text;
        overflow: elide;
    }
    if status != "": Text {
        x: 40 * u;
        y: 88 * u;
        width: parent.width - 80 * u;
        horizontal-alignment: rtl ? right : left;
        text: status;
        font-size: 25 * u;
        color: Theme.text-dim;
        overflow: elide;
    }
    Rectangle {
        y: list-y;
        height: parent.height - self.y - 16 * u;
        clip: true;
        for data[i] in rows: ControlRow {
            x: 16 * u;
            y: (i - first-row) * pitch;
            width: parent.width - 32 * u;
            u: root.u;
            rtl: root.rtl;
            text: data.title;
            detail: data.detail;
            current: data.current;
            dim: data.dim;
            slider: data.slider;
            level: data.level;
            tall: data.tall;
            selected: i == focused-row;
            visible: i >= first-row;
        }
        for data[i] in rows: TouchArea {
            x: 16 * u;
            y: (i - first-row) * pitch;
            width: parent.width - 32 * u;
            height: pitch;
            visible: i >= first-row;
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.row-hovered(i);
                }
            }
            clicked => { root.row-clicked(i); }
        }
    }
}

// The power menu, opened by the power key or the menu's Power entry: the
// whole screen dims and its actions stand large in the middle, as on Android
// TV. The rows are the platform's Power panel (src/device.rs).
export component PowerMenu inherits Rectangle {
    in property <length> u;
    in property <string> title;
    in property <string> status;
    in property <[SettingsRow]> rows;
    in property <int> focused-row;
    callback row-clicked(int);
    // The pointer moved onto row `index`.
    callback row-hovered(int);
    // A click beside the actions closes the menu.
    callback dismissed();

    property <length> pitch: 132 * u;
    property <length> button-width: 640 * u;
    property <length> list-height: rows.length * pitch;

    background: Theme.bg.with-alpha(max(Theme.scrim-opacity, 0.80));

    TouchArea {
        clicked => { root.dismissed(); }
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - list-height) / 2 - 220 * u;
        width: 96 * u;
        height: 96 * u;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 3 L 12 11 M 7.05 6.05 A 7 7 0 1 0 16.95 6.05";
        stroke: Theme.text;
        stroke-width: 2 * u;
        fill: transparent;
    }
    Text {
        y: (parent.height - list-height) / 2 - 100 * u;
        width: parent.width;
        horizontal-alignment: center;
        text: status != "" ? status : title;
        font-size: 36 * u;
        color: status != "" ? Theme.text-dim : Theme.text;
    }
    for data[i] in rows: Rectangle {
        property <bool> focused: i == focused-row;
        x: (parent.width - button-width) / 2;
        y: (parent.height - list-height) / 2 + i * pitch;
        width: button-width;
        height: pitch - 28 * u;
        border-radius: self.height / 2;
        background: !focused ? Theme.surface.with-alpha(Theme.panel-opacity)
            : Theme.selection-style == 1 ? Theme.accent
            : Theme.selection-style == 2 ? Theme.surface
            : Theme.text;
        border-width: focused && Theme.selection-style == 2 ? 3 * u : Theme.panel-border-width * u;
        border-color: focused && Theme.selection-style == 2 ? Theme.accent : Theme.panel-border-color;
        animate background { duration: 120ms * Theme.motion-scale; }
        property <color> fg: !focused ? Theme.text
            : Theme.selection-style == 1 ? Theme.accent-text
            : Theme.selection-style == 2 ? Theme.text
            : Theme.bg;
        Text {
            y: data.detail == "" ? 0 : 12 * u;
            width: parent.width;
            height: data.detail == "" ? parent.height : 46 * u;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: data.title;
            font-size: (data.detail == "" ? 38 : 32) * u;
            font-weight: 500;
            color: parent.fg;
        }
        if data.detail != "": Text {
            y: 56 * u;
            width: parent.width - 48 * u;
            x: 24 * u;
            height: 32 * u;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: data.detail;
            font-size: 22 * u;
            color: parent.focused ? parent.fg.with-alpha(0.75) : Theme.text-dim;
            overflow: elide;
        }
        TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.row-hovered(i);
                }
            }
            clicked => { root.row-clicked(i); }
        }
    }
}

// The volume bar: a speaker (crossed out when muted) and the level, at the
// top of the screen. Fades out when `shown` goes false (ui/device_view.rs
// hides it ~1.5 s after the last volume key).
export component VolumeOsd inherits Rectangle {
    in property <length> u;
    in property <bool> shown;
    in property <float> level;
    in property <bool> muted;

    width: 520 * u;
    height: 88 * u;
    border-radius: self.height / 2;
    background: Theme.surface.with-alpha(0.95);
    drop-shadow-color: #00000080;
    drop-shadow-blur: 32 * u;
    opacity: shown ? 1 : 0;
    visible: self.opacity > 0;
    animate opacity { duration: shown ? 120ms : 400ms; easing: ease-out; }

    Path {
        x: 30 * u;
        y: 22 * u;
        width: 44 * u;
        height: 44 * u;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: muted
            ? "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 16 9 L 22 15 M 22 9 L 16 15"
            : "M 3 9 L 7 9 L 12 5 L 12 19 L 7 15 L 3 15 Z M 15.5 9 A 4 4 0 0 1 15.5 15 M 18 6 A 8 8 0 0 1 18 18";
        stroke: Theme.text;
        stroke-width: 2.6 * u;
        fill: transparent;
    }
    Rectangle {
        x: 96 * u;
        y: (parent.height - self.height) / 2;
        width: 300 * u;
        height: 10 * u;
        border-radius: self.height / 2;
        background: #FFFFFF26;
        Rectangle {
            x: 0;
            width: parent.width * clamp(level, 0, 1);
            height: parent.height;
            border-radius: parent.border-radius;
            background: muted ? Theme.text-dim : Theme.accent;
        }
    }
    Text {
        x: 412 * u;
        width: 80 * u;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: right;
        text: muted ? @tr("Muted") : round(level * 100) + "%";
        font-size: 27 * u;
        font-weight: 500;
        color: Theme.text;
    }
}

// A text prompt: a Wi-Fi password, a name. A text field in the upper half;
// the system's on-screen keyboard (on Linux RustTV's, `linux/keyboard`)
// opens at the bottom when the field takes focus, as for any app. Enter
// confirms (`done`), Back or Escape cancels.
export component TextPromptView inherits Rectangle {
    in property <length> u;
    in property <string> title;
    in property <bool> secret;
    in-out property <string> text;
    callback done(string);
    callback cancelled();

    property <length> field-w: 1100 * u;
    property <length> left: (root.width - field-w) / 2;

    background: #000000E0;
    TouchArea { }

    Text {
        x: left;
        y: 160 * u;
        width: field-w;
        text: title;
        font-size: 36 * u;
        color: Theme.text;
        overflow: elide;
    }
    Rectangle {
        x: left;
        y: 224 * u;
        width: field-w;
        height: 92 * u;
        border-radius: 12 * u;
        background: Theme.surface;
        border-width: 2 * u;
        border-color: Theme.accent;
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape || event.text == "\u{F748}" {
                    root.cancelled();
                    return accept;
                }
                reject
            }
            field := TextInput {
                x: 28 * u;
                width: parent.width - 56 * u;
                height: parent.height;
                text <=> root.text;
                input-type: root.secret ? InputType.password : InputType.text;
                single-line: true;
                font-size: 40 * u;
                color: Theme.text;
                vertical-alignment: center;
                accepted => {
                    root.done(self.text);
                }
                init => {
                    self.focus();
                }
            }
        }
        TouchArea {
            clicked => { field.focus(); }
        }
    }
    Text {
        x: left;
        y: 340 * u;
        width: field-w;
        text: @tr("✓ on the keyboard confirms, Back cancels");
        font-size: 28 * u;
        color: Theme.text-dim;
        overflow: elide;
    }
}
